#!/bin/bash
# cmux-claude-queue — true prompt queue for Claude Code running inside cmux.
#
# Unlike typing into a running Claude session (which steers the current turn),
# this captures the message BEFORE it ever reaches Claude and delivers it as a
# fresh prompt only after the session goes idle. The running turn never sees it.
#
# Architecture (three cooperating entry points):
#
#   capture     scrapes the Claude input box off the terminal screen. Idle
#               session: just submits the draft. Turn running: clears the box
#               and appends the draft to the file queue; the pending queue
#               shows up in the Claude Code statusline (`statusline` mode).
#               Invoked manually, from the optional "queue-prompt" cmux
#               Command Palette action, or as the hotkey daemon's fallback —
#               on Opt+Enter the daemon normally does this part in-process
#               over its own warm control socket, because spawning this costs
#               100-500 ms of fork/exec + python start before anything visible
#               happens (see hotkeyd/main.swift).
#   spool       deferred half of that in-process capture, spawned by the
#               daemon once the box is already cleared. Reads the spooled raw
#               screen dump, parses the draft, appends it to the queue and
#               nudges delivery. Everything here is off the perceived path.
#   statusline  Claude Code statusLine command (settings.json): runs the
#               user's previous statusline command first (chain file), then
#               appends one row with the pending queue for the session on
#               stdin, when non-empty. Also acts as the delivery pump: an Esc
#               interrupt produces no turn-complete notification, so the
#               statusline refresh fires an invisible retry tick instead.
#   notifyhook  registered in cmux.json notifications.hooks. cmux invokes it on
#               every scheduled notification (agent turn complete etc.), passing
#               the policy JSON on stdin. It echoes the JSON back unchanged, then
#               tries to deliver one queued line for every surface with a
#               non-empty queue. Turn-complete notifications are what normally
#               flush the queue; any other notification acts as a retry tick.
#
# The cmux socket in its default "cmuxOnly" mode rejects clients that are not
# cmux descendants, and the hotkey daemon is not one — the install therefore
# requires automation.socketControlMode "password" in cmux.json (the cmux CLI
# then auto-authenticates via the stored password).
#
# Modes:
#   cmux-claude-queue capture              scrape + clear + enqueue + deliver-if-idle
#   cmux-claude-queue spool <surface>      drain spooled captures into the queue
#   cmux-claude-queue statusline           Claude Code statusLine wrapper (JSON stdin)
#   cmux-claude-queue notifyhook           cmux notification hook (JSON stdin/stdout)
#   cmux-claude-queue add <surface> <text> enqueue text for a surface, deliver if idle
#   cmux-claude-queue drain <surface>      blocking drain loop (manual/debug use)
#
# State: ~/.claude/prompt-queue/<surfaceId>.queue (one message per line)
#        ~/.claude/prompt-queue/<surfaceId>.<epochMs>.spool (in-flight capture)

set -u

QDIR="$HOME/.claude/prompt-queue"
STORE="$HOME/.cmuxterm/claude-hook-sessions.json"
EVENTS="$HOME/.cmuxterm/events.jsonl"
CMUX_BIN="${CMUX_CLAUDE_HOOK_CMUX_BIN:-cmux}"
# notification hooks run via /bin/sh with a minimal PATH; fall back to the bundle
command -v "$CMUX_BIN" >/dev/null 2>&1 || CMUX_BIN="/Applications/cmux.app/Contents/Resources/bin/cmux"
mkdir -p "$QDIR"

# ── Fast dispatch ────────────────────────────────────────────────────────────
# The two hot entry points run from here, before bash parses the ~1000 lines
# of function definitions below: the statusline pays that parse every second
# in every open session, the capture at every keypress. Both arms are
# self-contained; the capture arm falls through to the full CLI path below
# when the socket fast path is unavailable.
# Closing our own surface is right for the Command Palette action tab, which
# cmux creates for this one command and nothing else. It is wrong everywhere
# else, and CMUX_SURFACE_ID cannot tell the two apart: it is set in every cmux
# terminal, so a bare `cmux-claude-queue` typed into a shell used to close that
# shell's pane. Require the caller to opt in instead.
CLOSE_TAB=""
case " $* " in *" --close-tab "*) CLOSE_TAB="${CMUX_SURFACE_ID:-}" ;; esac
export CMUX_CLAUDE_QUEUE_CLOSE_TAB="$CLOSE_TAB"

case "${1:-capture}" in
  statusline)
    # Claude Code statusLine command: if the user had their own statusline
    # command before installing, it lives in the chain file (a shell script
    # that gets the statusline JSON on stdin); run it first and print its
    # output untouched, then append one row with this session's pending queue.
    # Empty queue = no extra row, the statusline shrinks back automatically.
    # builtin read instead of a cat spawn (hot path, see below); -d '' reads
    # to EOF and preserves inner newlines, the rc=1 at EOF is expected
    payload=""
    IFS= read -r -d '' payload || :
    chain="$HOME/.config/cmux-claude-queue/statusline-chain"
    # This is the hottest path in the whole tool: every open session runs it
    # on every refresh. session_id is a UUID in flat JSON, so a bash substring
    # replaces a plutil spawn; plutil stays as the fallback for any shape the
    # substring does not recognize.
    sid=${payload#*\"session_id\"}
    if [ "$sid" = "$payload" ]; then
      sid=""
    else
      sid=${sid#*\"}; sid=${sid%%\"*}
    fi
    case "$sid" in
      *[!0-9a-fA-F-]*|'')
        sid=$(printf '%s' "$payload" | plutil -extract session_id raw -o - -- - 2>/dev/null) ;;
    esac
    # opt-in refresh-cadence tracing: create the flag file to log one line
    # per wrapper run; costs a single builtin test when absent
    [ -f "$QDIR/debug-cadence" ] \
      && printf '%s %s\n' "$(date '+%s')" "$sid" >> "$QDIR/debug-cadence" 2>/dev/null
    # The sid -> surface mapping is stable for the life of a session binding,
    # so it is cached in a file and read with a builtin instead of two plutil
    # spawns per refresh. The cache is re-validated from the store below
    # whenever a row might actually render (some queue is pending) — a cmux
    # restart rebinds a resumed session to a new surface id while the sid
    # persists, and a stale "not mine" must never hide a pending row.
    resolve_surf() {
      surf=$(plutil -extract "sessions.$sid.surfaceId" raw -o - -- "$STORE" 2>/dev/null) \
        || surf=$(plutil -extract "sessions.claude-$sid.surfaceId" raw -o - -- "$STORE" 2>/dev/null) \
        || surf=""
      [ -n "$surf" ] && printf '%s\n' "$surf" > "$QDIR/sidmap-$sid"
    }
    surf=""
    if [ -n "$sid" ]; then
      if [ -f "$QDIR/sidmap-$sid" ]; then
        IFS= read -r surf < "$QDIR/sidmap-$sid" 2>/dev/null || surf=""
      fi
      [ -z "$surf" ] && resolve_surf
    fi
    if [ -f "$chain" ]; then
      # The chained statusline is the expensive part (user HUDs tend to run
      # git status and friends — seconds per run on a loaded machine), and
      # Claude Code kills a statusline command that is still running when the
      # next refresh comes due (hit live: cold chain runs never finished, so
      # the queue row and the delivery pump below silently stopped). The
      # chain therefore NEVER runs in the foreground: the last output is
      # served from a per-session cache immediately, and once the cache is
      # older than 180 s a detached background job refreshes it for later
      # runs. The wrapper stays fast no matter what the chain costs;
      # branch/context info lagging ~180 s is the trade.
      cache=""
      [ -n "$sid" ] && cache="$QDIR/slcache-$sid"
      if [ -z "$cache" ]; then
        # no session id to key a cache by: degrade to a foreground run
        base=$(printf '%s' "$payload" | /bin/sh "$chain" 2>/dev/null) || base=""
        [ -n "$base" ] && printf '%s\n' "$base"
      else
        # $(<file) forks but does not exec — measurably cheaper than cat here
        if [ -s "$cache" ]; then printf '%s\n' "$(<"$cache")"; fi
        guard="$cache.bg"
        if [ -z "$(/usr/bin/find "$cache" -newermt '-180 seconds' 2>/dev/null)" ] \
           && [ -z "$(/usr/bin/find "$guard" -newermt '-30 seconds' 2>/dev/null)" ]; then
          # the guard records the worker pid: a chain that hangs past the
          # 30 s crash TTL is killed here, not accumulated one process per
          # respawn. The comm check avoids killing an innocent process that
          # recycled the pid.
          oldbg=$(cat "$guard" 2>/dev/null)
          if [ -n "$oldbg" ]; then
            case "$(ps -o comm= -p "$oldbg" 2>/dev/null)" in
              *bash|*sh) kill -9 "$oldbg" 2>/dev/null ;;
            esac
          fi
          : > "$guard"  # one refresh in flight at a time; 30 s crash TTL
          (
            trap '' TERM HUP
            # macOS /bin/bash is 3.2 and has no $BASHPID — under set -u the
            # reference killed this subshell before it ever wrote the cache
            # (hit live: fresh sessions had a permanently blank statusline).
            # The PPID of a child shell is this subshell's pid.
            mypid=$(/bin/sh -c 'echo "$PPID"')
            echo "$mypid" > "$guard"
            out=$(printf '%s' "$payload" | /bin/sh "$chain" 2>/dev/null) || out=""
            if [ -n "$out" ]; then printf '%s\n' "$out" > "$guard.$mypid"
            else : > "$guard.$mypid"; fi
            mv -f "$guard.$mypid" "$cache" 2>/dev/null
            rm -f "$guard"
            /usr/bin/find "$QDIR" -name 'slcache-*' -mtime +1 -delete 2>/dev/null
          ) </dev/null >/dev/null 2>&1 &
        fi
      fi
    fi
    # a capture is in flight (hotkey pressed, box not read/enqueued yet):
    # show the queue row with a placeholder so feedback is one refresh away.
    # The global stamp is pre-touched by the hotkey daemon at the keypress
    # itself and exists only until target resolution (~0.3 s, short TTL so
    # unrelated sessions barely flash it); after that the capture renames it
    # per-surface and only the captured session's row shows it. The [ -f ]
    # guards keep the find spawns off the common no-capture path, and once
    # the queue file has content the real row below replaces the placeholder.
    show_ph=""
    if [ -f "$QDIR/capturing.stamp" ]; then
      if [ -n "$(/usr/bin/find "$QDIR/capturing.stamp" -newermt '-2 seconds' 2>/dev/null)" ]; then
        show_ph=1
      elif [ -z "$(/usr/bin/find "$QDIR/capturing.stamp" -newermt '-60 seconds' 2>/dev/null)" ]; then
        # the hotkey daemon pre-touches this stamp at the keypress; if the
        # capture never spawned, nothing else would ever remove it (a live
        # capture owns it for at most a few seconds, so 60 s = orphan)
        rm -f "$QDIR/capturing.stamp"
      fi
    fi
    if [ -z "$show_ph" ] && [ -n "$surf" ] && [ -f "$QDIR/capturing-$surf.stamp" ]; then
      if [ -n "$(/usr/bin/find "$QDIR/capturing-$surf.stamp" -newermt '-6 seconds' 2>/dev/null)" ]; then
        show_ph=1
      else
        # a crashed capture's leftover: drop it so it stops costing a find
        rm -f "$QDIR/capturing-$surf.stamp"
      fi
    fi
    if [ -n "$show_ph" ] && { [ -z "$surf" ] || [ ! -s "$QDIR/$surf.queue" ]; }; then
      printf '\033[33m⏳ Queuing…\033[0m\n'
    fi
    # An orphaned spool holds the ONLY copy of a draft: the hotkey daemon
    # spooled it and cleared the box, then its handler never ran. Nothing else
    # will notice it here — the pending check below cannot see it (no queue
    # file exists yet), and the notifyhook's recovery sweep needs a
    # notification, which an Esc-interrupted turn never produces. So run the
    # handler straight from here, detached, throttled to one attempt per 10 s
    # across all sessions. Anything under 5 s old is a live handoff.
    for sf in "$QDIR"/*.spool; do
      [ -e "$sf" ] || break   # no matches: the glob came through unexpanded
      [ -n "$(/usr/bin/find "$sf" -newermt '-5 seconds' 2>/dev/null)" ] && continue
      if [ -z "$(/usr/bin/find "$QDIR/spoolsweep.stamp" -newermt '-10 seconds' 2>/dev/null)" ]; then
        touch "$QDIR/spoolsweep.stamp"
        sb=${sf##*/}; sb=${sb%.*.spool}
        # ignored signals survive exec, so the handler cannot be killed by
        # Claude Code reaping this statusline run's process group when the next
        # refresh comes due — killed between the queue append and the spool
        # delete, the next poke would enqueue the same draft again
        (trap '' TERM HUP; "$0" spool "$sb" </dev/null >/dev/null 2>&1 &)
      fi
      break
    done
    # cheap out: no queue file with content anywhere -> skip the lookup
    pending=""
    for qf in "$QDIR"/*.queue; do
      [ -s "$qf" ] && { pending=1; break; }
    done
    [ -z "$pending" ] && exit 0
    # some queue IS pending: never trust the cached mapping to say "not
    # mine" — re-resolve from the store (see resolve_surf above), but at most
    # every 30 s: a queue orphaned by a cmux restart can pend for days, and
    # unthrottled this would cost two plutil spawns per refresh in EVERY open
    # session for as long as it does. A store miss keeps the cached value
    # (better a possibly stale row than a blinking one) and is throttled the
    # same way.
    if [ -n "$sid" ]; then
      if [ ! -f "$QDIR/sidmap-$sid" ] \
         || [ -z "$(/usr/bin/find "$QDIR/sidmap-$sid" -newermt '-30 seconds' 2>/dev/null)" ]; then
        prev_surf=$surf
        resolve_surf
        if [ -z "$surf" ]; then
          surf=$prev_surf
          [ -f "$QDIR/sidmap-$sid" ] && touch "$QDIR/sidmap-$sid" 2>/dev/null
        fi
      fi
    fi
    # a python only runs below, in the one session that actually owns a
    # pending queue — not in every session that refreshes while some queue
    # is waiting
    { [ -z "$surf" ] || [ ! -s "$QDIR/$surf.queue" ]; } && exit 0
    out=$(python3 -c '
import sys
try:
    with open(sys.argv[1]) as f:
        items = [l.strip() for l in f if l.strip()]
    if not items:
        raise SystemExit
    DIM, YEL, RST = "\033[2m", "\033[33m", "\033[0m"
    nxt = items[0][:70] + ("…" if len(items[0]) > 70 else "")
    more = f" {DIM}+{len(items) - 1} more{RST}" if len(items) > 1 else ""
    print(f"{YEL}⏳ Queue:{RST} {nxt}{more}")
except Exception:
    pass' "$QDIR/$surf.queue" 2>/dev/null)
    [ -z "$out" ] && exit 0
    printf '%s\n' "$out"
    # delivery pump: an Esc interrupt kills a turn WITHOUT any Stop hook or
    # turn-complete notification, so a queued prompt would otherwise wait for
    # an unrelated notification. The statusline re-runs on refreshInterval;
    # while this session's queue is non-empty, fire the invisible retry tick
    # at most every 15 s — the notifyhook does the actual careful delivery.
    stamp="$QDIR/tick.stamp"
    if [ -z "$(/usr/bin/find "$stamp" -newermt '-15 seconds' 2>/dev/null)" ]; then
      touch "$stamp"
      "$CMUX_BIN" notify --title "cmux-claude-queue-tick" --body tick --surface "$surf" >/dev/null 2>&1
    fi
    exit 0
    ;;
  capture)
    # Instant statusline feedback: the hotkey daemon pre-touches this stamp
    # at the keypress; refresh it here for non-daemon callers and own its
    # cleanup (the fast path renames it per-surface once the target is known)
    cstamp="$QDIR/capturing.stamp"
    touch "$cstamp"
    trap 'rm -f "$cstamp"' EXIT
    # Fast path: one python over cmux's control socket. A cmux CLI spawn
    # costs ~140 ms per call and the capture needs three serially; a socket
    # request costs ~2 ms, so press-to-box-cleared drops from over a second
    # under load to roughly 100 ms. Exit 0 = fully handled. Any other exit
    # falls through to the CLI path below (socket gone, auth refused, older
    # cmux without these methods); the python mutates nothing before its
    # queue append, so the fallback can always rerun the whole sequence —
    # at worst the double-press guard drops the fallback's re-scrape.
    if python3 - "$STORE" "$EVENTS" "$QDIR" <<'FASTPY'
import json, os, re, socket, sys, time

store_path, events_path, qdir = sys.argv[1], sys.argv[2], sys.argv[3]
T0 = time.monotonic()
stages = []

def mark(name, t0):
    stages.append("%s:%d" % (name, int((time.monotonic() - t0) * 1000)))

def qlog(msg):
    with open(qdir + "/log.txt", "a") as f:
        f.write(time.strftime("%H:%M:%S") + " " + msg + "\n")

# Any failure before the queue append exits 1 with nothing mutated; the bash
# CLI fallback then redoes the whole capture from scratch.
t0 = time.monotonic()
state = os.path.expanduser("~/.local/state/cmux")
cands = []
try:
    p = open(state + "/last-socket-path").read().strip()
    if p:
        cands.append(p)
except OSError:
    pass
cands += [state + "/cmux-%d.sock" % os.getuid(), state + "/cmux.sock"]
sock = None
for c in cands:
    try:
        s_ = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s_.settimeout(4)
        s_.connect(c)
        sock = s_
        break
    except OSError:
        continue
if sock is None:
    sys.exit(1)

buf = bytearray()
def readline():
    while b"\n" not in buf:
        chunk = sock.recv(65536)
        if not chunk:
            raise RuntimeError("socket closed")
        buf.extend(chunk)
    line, rest = bytes(buf).split(b"\n", 1)
    del buf[:]
    buf.extend(rest)
    return line

pw = ""
try:
    pw = open(state + "/socket-control-password").read().strip()
except OSError:
    pass
if not pw:
    try:
        cj = json.load(open(os.path.expanduser("~/.config/cmux/cmux.json")))
        pw = (cj.get("automation") or {}).get("socketPassword") or ""
    except Exception:
        pass
sock.sendall(("auth " + pw + "\n").encode())
if not readline().startswith(b"OK"):
    sys.exit(1)

_rid = [0]
def call(method, params):
    _rid[0] += 1
    req = {"id": _rid[0], "method": method, "params": params}
    sock.sendall((json.dumps(req, separators=(",", ":")) + "\n").encode())
    r = json.loads(readline())
    if not r.get("ok"):
        raise RuntimeError("%s: %s" % (method, r.get("error")))
    return r.get("result") or {}
mark("auth", t0)

t0 = time.monotonic()
ws = os.environ.get("CMUX_WORKSPACE_ID") or ""
if not ws:
    ws = call("workspace.current", {}).get("workspace", {}).get("id") or ""
if not ws:
    sys.exit(1)
target = sid = ""
running = 0
try:
    d = json.load(open(store_path))
except Exception:
    d = {}
s0 = (d.get("activeSessionsByWorkspace", {}).get(ws, {}).get("sessionId") or "")
if s0.startswith("claude-"):
    s0 = s0[7:]
sess = d.get("sessions", {}).get(s0, {})
if sess.get("surfaceId"):
    target, sid = sess["surfaceId"], s0
    if sess.get("agentLifecycle") == "running":
        running = 1
if not target:
    # store miss (e.g. right after a cmux restart): live surface.list truth
    best = None
    for sr in call("surface.list", {"workspace_id": ws}).get("surfaces", []):
        rb = sr.get("resume_binding") or {}
        if rb.get("kind") == "claude" and sr.get("id"):
            t = rb.get("updated_at") or 0
            if best is None or t > best[0]:
                best = (t, sr["id"])
    if best:
        target = best[1]
        running = 1  # lifecycle unknown: queueing beats a blind submit
if not target:
    sys.exit(1)  # the CLI fallback owns the "no claude session" messaging
if sid and not running:
    # the store lags right after a submit; cross-check fresh hook events
    try:
        f = open(events_path, "rb")
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 2097152))
        needle = ("claude-" + sid).encode()
        last = b""
        for line in f.read().splitlines():
            if needle in line and (b"agent.hook.UserPromptSubmit" in line
                                   or b'"agent.hook.Stop"' in line):
                last = line
        if b"UserPromptSubmit" in last:
            running = 1
    except OSError:
        pass
# A delivery is typing into this box right now: what is in it is the pump's
# own prompt, not a draft of the user's. Scraping it would clear the pump's
# text mid-send and queue a second copy of a prompt already on its way.
# Nothing of the user's is lost by declining — there was nothing of theirs
# in there.
try:
    holder = int(os.readlink(qdir + "/" + target + ".lock"))
    os.kill(holder, 0)
    qlog("capture surface=%s delivery in flight, ignoring press" % target)
    sys.exit(0)
except (OSError, ValueError):
    pass

# narrow the transient placeholder row to the captured session
surface_stamp = qdir + "/capturing-" + target + ".stamp"
try:
    os.replace(qdir + "/capturing.stamp", surface_stamp)
except OSError:
    try:
        open(surface_stamp, "w").close()
    except OSError:
        pass
mark("resolve", t0)

t0 = time.monotonic()
def read_box():
    # same width-aware rules as parse_input_box; read_text renders NBSP
    # where the CLI read-screen renders plain spaces
    dump = (call("surface.read_text", {"surface_id": target}).get("text") or "")
    lines = dump.replace("\xa0", " ").split("\n")
    seps = [i for i, l in enumerate(lines) if re.match(r"^\s*─{20,}\s*$", l)]
    if len(seps) < 2:
        return "", 0
    width = len(lines[seps[-1]].rstrip())
    region = lines[seps[-2] + 1:seps[-1]]
    pieces, started = [], False
    for l in region:
        full = len(l.rstrip()) >= width - 2
        if not started:
            m = re.match(r"^ ?[❯>]\s?(.*)$", l)
            if m:
                started = True
                pieces.append((m.group(1).rstrip(), full))
        else:
            t = l.rstrip()
            if t.startswith("  "):
                t = t[2:]
            pieces.append((t, full))
    out = []
    for t, full in pieces:
        if not t:
            continue
        out.append(t)
        out.append("" if full else " ")
    return "".join(out).strip(), len(region)

text, rows = read_box()
mark("read", t0)

def finish():
    try:
        os.remove(surface_stamp)
    except OSError:
        pass
    own = os.environ.get("CMUX_CLAUDE_QUEUE_CLOSE_TAB") or ""
    if own:
        # Command Palette path: hand focus back and close our action tab
        for m, p in (("surface.focus", {"surface_id": target}),
                     ("surface.close", {"surface_id": own})):
            try:
                call(m, p)
            except Exception:
                pass
    sys.exit(0)

if not running:
    if text:
        call("surface.send_key", {"surface_id": target, "key": "enter"})
        qlog("capture surface=%s idle, submitted draft: %s" % (target, text))
    finish()

if not text:
    finish()

# double-press guard: an identical tail line captured within 3 s is the
# second press racing the box clear, not an intentional repeat
qfile = qdir + "/" + target + ".queue"
dup = False
try:
    st = os.stat(qfile)
    if st.st_size and time.time() - st.st_mtime < 3:
        with open(qfile) as f:
            qlines = [l.rstrip("\n") for l in f if l.strip()]
        if qlines and qlines[-1] == text:
            dup = True
except OSError:
    pass

if dup:
    qlog("capture surface=%s dropped double-press duplicate: %s" % (target, text))
else:
    # record first, clear second: killed in between, the draft is both
    # queued and still in the box (delivery treats box == line as
    # clear-and-resend), so nothing is lost
    t0 = time.monotonic()
    lock = qdir + "/" + target + ".qlock"
    got = False
    for _ in range(20):
        try:
            os.mkdir(lock)
            got = True
            break
        except FileExistsError:
            try:
                if time.time() - os.stat(lock).st_mtime > 5:
                    os.rmdir(lock)
                    continue
            except OSError:
                continue
            time.sleep(0.05)
    try:
        empty = True
        try:
            empty = os.path.getsize(qfile) == 0
        except OSError:
            pass
        if empty:
            try:
                with open(qdir + "/" + target + ".qoffset", "w") as f:
                    f.write("%d\n" % os.path.getsize(events_path))
            except OSError:
                pass
        with open(qfile, "a") as f:
            f.write(text + "\n")
    finally:
        if got:
            try:
                os.rmdir(lock)
            except OSError:
                pass
    mark("append", t0)

# Clear the WHOLE box: Ctrl+U alone only kills the current line (hit live
# with a multi-line draft, the other lines stayed behind). Per row: Ctrl+K
# (cursor to EOL), Ctrl+U (to line start), Backspace (join up); every key
# no-ops on an empty box, so overshooting by two cycles is free.
t0 = time.monotonic()
def clear_cycles(n):
    call("surface.send_text", {"surface_id": target, "text": "\x0b\x15\x7f" * n})
cleared = False
clear_cycles(rows + 2)
time.sleep(0.06)  # give the TUI one redraw before verifying, or the first
                  # read always shows the old content and costs a retry round
for _ in range(3):
    box2, rows2 = read_box()
    if not box2 or box2 not in text:
        cleared = True  # empty, or unrelated content (ghost suggestion)
        break
    clear_cycles(rows2 + 2)
    time.sleep(0.12)
mark("clear", t0)

if not dup:
    qlog("capture surface=%s queued in %dms via socket (%s)%s: %s"
         % (target, int((time.monotonic() - T0) * 1000), " ".join(stages),
            "" if cleared else " [box not fully cleared]", text))
    # insurance tick: if the turn actually just ended (stale running state)
    # the hook delivers right away; while truly running it no-ops
    try:
        call("notification.create_for_surface",
             {"surface_id": target, "title": "cmux-claude-queue-tick",
              "body": "tick"})
    except Exception:
        pass
finish()
FASTPY
    then
      exit 0
    fi
    printf '%s %s\n' "$(date '+%H:%M:%S')" \
      "capture: socket fast path failed, using CLI fallback" >> "$QDIR/log.txt"
    ;;
  spool)
    # Deferred half of the hotkey daemon's in-process capture. The daemon has
    # already spooled the raw screen dump and cleared the box (that is the part
    # the user waits for); everything here is off the perceived path, so it
    # stays in python where the subtle logic already lives and is debugged.
    #
    # Spools are named <surfaceId>.<epochMs>.spool, so sorting them by name
    # replays presses in order. Every spool is deleted only after its draft is
    # in the queue file, which is what makes a crashed or never-spawned handler
    # recoverable: the next capture — or the notifyhook's orphan sweep — picks
    # up whatever is left behind.
    surf="${2:-}"
    [ -z "$surf" ] && exit 0
    if ! python3 - "$QDIR" "$EVENTS" "$surf" <<'SPOOLPY'
import json, os, re, socket, sys, time

qdir, events_path, surf = sys.argv[1], sys.argv[2], sys.argv[3]
T0 = time.monotonic()
qfile = qdir + "/" + surf + ".queue"

def qlog(msg):
    with open(qdir + "/log.txt", "a") as f:
        f.write(time.strftime("%H:%M:%S") + " " + msg + "\n")

# Identical rules to the capture fast path's read_box, against the spooled
# dump instead of a live socket read. The width-aware join — a trailing space
# is a real space, a full-width row is a hard wrap with none — is what the
# daemon deliberately does NOT reimplement in Swift: it only counts rows and
# asks whether the box is non-empty, so the delicate part stays on this side.
# (It is not single-sourced even here: parse_input_box, capture_ctx and FASTPY
# read_box each carry the same rules for their own entry point.)
def parse_box(dump):
    lines = dump.replace("\xa0", " ").split("\n")
    seps = [i for i, l in enumerate(lines) if re.match(r"^\s*─{20,}\s*$", l)]
    if len(seps) < 2:
        return "", 0
    width = len(lines[seps[-1]].rstrip())
    region = lines[seps[-2] + 1:seps[-1]]
    pieces, started = [], False
    for l in region:
        full = len(l.rstrip()) >= width - 2
        if not started:
            m = re.match(r"^ ?[❯>]\s?(.*)$", l)
            if m:
                started = True
                pieces.append((m.group(1).rstrip(), full))
        else:
            t = l.rstrip()
            if t.startswith("  "):
                t = t[2:]
            pieces.append((t, full))
    out = []
    for t, full in pieces:
        if not t:
            continue
        out.append(t)
        out.append("" if full else " ")
    return "".join(out).strip(), len(region)

def enqueue(text):
    lock = qdir + "/" + surf + ".qlock"
    got = False
    for _ in range(20):
        try:
            os.mkdir(lock)
            got = True
            break
        except FileExistsError:
            try:
                if time.time() - os.stat(lock).st_mtime > 5:
                    os.rmdir(lock)
                    continue
            except OSError:
                continue
            time.sleep(0.05)
    try:
        # Double-press guard: a second Opt+Enter can outrun the box clear and
        # spool the same draft again. An identical line appended moments ago is
        # that race, not an intentional repeat.
        #
        # Checked INSIDE the lock. Three things now spawn this handler — the
        # daemon after a capture, the statusline's orphan poke and the
        # notifyhook sweep — so two of them running for the same surface is an
        # ordinary occurrence, not a freak one. Checked before taking the lock,
        # both would read the same queue tail, both would pass, and the lock
        # would then serialize two appends of the same prompt.
        try:
            st = os.stat(qfile)
            if st.st_size and time.time() - st.st_mtime < 3:
                with open(qfile) as f:
                    qlines = [l.rstrip("\n") for l in f if l.strip()]
                if qlines and qlines[-1] == text:
                    return False
        except OSError:
            pass
        # first line into an empty queue: remember where the event log stood,
        # so delivery can tell "already submitted since queueing" apart from
        # any older identical submit
        empty = True
        try:
            empty = os.path.getsize(qfile) == 0
        except OSError:
            pass
        if empty:
            try:
                with open(qdir + "/" + surf + ".qoffset", "w") as f:
                    f.write("%d\n" % os.path.getsize(events_path))
            except OSError:
                pass
        with open(qfile, "a") as f:
            f.write(text + "\n")
    finally:
        if got:
            try:
                os.rmdir(lock)
            except OSError:
                pass
    return True

try:
    names = sorted(n for n in os.listdir(qdir)
                   if n.startswith(surf + ".") and n.endswith(".spool"))
except OSError:
    names = []
if not names:
    sys.exit(0)

t0 = time.monotonic()
last_text, last_rows, queued, dropped = "", 0, 0, 0
for name in names:
    path = qdir + "/" + name
    try:
        with open(path, encoding="utf-8") as f:
            meta = json.loads(f.readline())
            dump = f.read()
    except Exception:
        # unreadable spool: nothing to recover, drop it rather than have the
        # orphan sweep retry it forever
        try:
            os.remove(path)
        except OSError:
            pass
        continue
    text, rows = parse_box(dump)
    if not rows:
        rows = meta.get("rows") or 0
    if text:
        last_text, last_rows = text, rows
        if enqueue(text):
            queued += 1
            qlog("spool surface=%s queued: %s" % (surf, text))
        else:
            dropped += 1
            qlog("spool surface=%s dropped double-press duplicate: %s" % (surf, text))
    try:
        os.remove(path)
    except OSError:
        pass
append_ms = int((time.monotonic() - t0) * 1000)

# the placeholder row has done its job once the real queue row can render
try:
    os.remove(qdir + "/capturing-" + surf + ".stamp")
except OSError:
    pass

if not queued and not dropped:
    sys.exit(0)

# Verify the daemon's clear landed, and nudge delivery. Both need the control
# socket, but neither is on the perceived path, so a cold connect is fine here
# (and a failure only costs a CLI notify fallback in the caller).
state = os.path.expanduser("~/.local/state/cmux")
cands = []
try:
    p = open(state + "/last-socket-path").read().strip()
    if p:
        cands.append(p)
except OSError:
    pass
cands += [state + "/cmux-%d.sock" % os.getuid(), state + "/cmux.sock"]
sock = None
for c in cands:
    try:
        s_ = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s_.settimeout(4)
        s_.connect(c)
        sock = s_
        break
    except OSError:
        continue
if sock is None:
    sys.exit(2)  # caller falls back to a CLI notify tick

buf = bytearray()
def readline():
    while b"\n" not in buf:
        chunk = sock.recv(65536)
        if not chunk:
            raise RuntimeError("socket closed")
        buf.extend(chunk)
    line, rest = bytes(buf).split(b"\n", 1)
    del buf[:]
    buf.extend(rest)
    return line

pw = ""
try:
    pw = open(state + "/socket-control-password").read().strip()
except OSError:
    pass
if not pw:
    try:
        cj = json.load(open(os.path.expanduser("~/.config/cmux/cmux.json")))
        pw = (cj.get("automation") or {}).get("socketPassword") or ""
    except Exception:
        pass
sock.sendall(("auth " + pw + "\n").encode())
if not readline().startswith(b"OK"):
    sys.exit(2)

_rid = [0]
def call(method, params):
    _rid[0] += 1
    req = {"id": _rid[0], "method": method, "params": params}
    sock.sendall((json.dumps(req, separators=(",", ":")) + "\n").encode())
    r = json.loads(readline())
    if not r.get("ok"):
        raise RuntimeError("%s: %s" % (method, r.get("error")))
    return r.get("result") or {}

def clear_cycles(n):
    call("surface.send_text", {"surface_id": surf, "text": "\x0b\x15\x7f" * n})

cleared = True
try:
    if last_text:
        # The box is already visually clear by the time this runs — the daemon
        # cleared it before spawning us — so anything found here is either a
        # clear that did not land, or the user typing their NEXT draft. The
        # whole point of the fast path is to invite exactly that follow-up
        # typing, so the test has to be strict: only a substantial remnant
        # counts as un-cleared. A bare "box in last_text" would treat the first
        # few characters of a similar next draft ("fix" against "fix the
        # tests") as leftovers and delete the user's live keystrokes. The old
        # spawn-free path could be loose about this because it verified within
        # ~60 ms, before anyone could type.
        cleared = False
        time.sleep(0.06)
        for _ in range(3):
            box, rows = parse_box(call("surface.read_text",
                                       {"surface_id": surf}).get("text") or "")
            remnant = box == last_text or (len(box) >= 8 and box in last_text)
            if not remnant:
                cleared = True
                break
            clear_cycles((rows or last_rows) + 2)
            time.sleep(0.12)
    # insurance tick: if the turn actually just ended (stale running state)
    # the hook delivers right away; while truly running it no-ops
    call("notification.create_for_surface",
         {"surface_id": surf, "title": "cmux-claude-queue-tick", "body": "tick"})
except Exception:
    sys.exit(2)

qlog("spool surface=%s handled %d queued %d dup in %dms (append:%d)%s"
     % (surf, queued, dropped, int((time.monotonic() - T0) * 1000), append_ms,
        "" if cleared else " [box needed re-clear]"))
SPOOLPY
    then
      # no socket: keep the delivery nudge, just pay a CLI spawn for it
      "$CMUX_BIN" notify --title "cmux-claude-queue-tick" --body tick \
        --surface "$surf" >/dev/null 2>&1
    fi
    exit 0
    ;;
esac


# Every mtime age check below pins /usr/bin/find: the -newermt '-N seconds'
# relative form is what macOS find parses, while common PATH replacements
# (bfs, GNU findutils) reject or reinterpret it — silently, inside $().

# Socket auth: no password handling here on purpose. The cmux CLI resolves it
# itself (--password, then CMUX_SOCKET_PASSWORD, then the password store cmux
# maintains from cmux.json), so even callers with no cmux env at all — the
# hotkey daemon, detached shells — authenticate without us spawning anything.

log() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >> "$QDIR/log.txt"; }

# agentLifecycle of the session active on a surface: running | idle | needsInput | unknown
# (store session ids appear both bare and "claude-"-prefixed across cmux versions)
lifecycle() {
  python3 - "$STORE" "$1" <<'PY' 2>/dev/null || echo unknown
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sid = d.get("activeSessionsBySurface", {}).get(sys.argv[2], {}).get("sessionId") or ""
    if sid.startswith("claude-"):
        sid = sid[7:]
    print(d.get("sessions", {}).get(sid, {}).get("agentLifecycle", "unknown"))
except Exception:
    print("unknown")
PY
}

# bare sessionId (no "claude-" prefix) active on a surface
session_of() {
  python3 - "$STORE" "$1" <<'PY' 2>/dev/null
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sid = d.get("activeSessionsBySurface", {}).get(sys.argv[2], {}).get("sessionId") or ""
    if sid.startswith("claude-"):
        sid = sid[7:]
    print(sid)
except Exception:
    pass
PY
}

# surfaceId of the Claude session active in a workspace. Primary source is the
# live surface.list rpc (resume_binding.kind == "claude") — the hook-session
# store lags after a cmux restart until the session fires its next hook, which
# is exactly when Cmd+Enter used to fail with "no claude session".
target_surface() {
  local t
  t=$("$CMUX_BIN" rpc surface.list "{\"workspace_id\": \"$1\"}" 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
best = None
for s in d.get("surfaces", []):
    rb = s.get("resume_binding") or {}
    if rb.get("kind") == "claude" and s.get("id"):
        t = rb.get("updated_at") or 0
        if best is None or t > best[0]:
            best = (t, s["id"])
if best:
    print(best[1])
' 2>/dev/null)
  if [ -n "$t" ]; then printf '%s\n' "$t"; return; fi
  python3 - "$STORE" "$1" <<'PY' 2>/dev/null
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sid = d.get("activeSessionsByWorkspace", {}).get(sys.argv[2], {}).get("sessionId") or ""
    if sid.startswith("claude-"):
        sid = sid[7:]
    print(d.get("sessions", {}).get(sid, {}).get("surfaceId", ""))
except Exception:
    pass
PY
}

# Extract the input-box text from a read-screen dump: the region between the
# last two full-width separator lines, minus the "❯ " prompt. Wrapping is
# reconstructed from row widths (hit live with a long URL): a row that runs
# to the box edge is a hard visual wrap and continues WITHOUT a separator,
# a short row ends with a real line break and joins with a single space.
# Continuation rows drop their two-space indent — the old parser kept it and
# joined every row with a space, splicing "   " into the middle of URLs.
parse_input_box() {
  python3 -c '
import re, sys
lines = sys.stdin.read().split("\n")
seps = [i for i, l in enumerate(lines) if re.match(r"^\s*─{20,}\s*$", l)]
if len(seps) < 2:
    sys.exit(0)
width = len(lines[seps[-1]].rstrip())
region = lines[seps[-2] + 1 : seps[-1]]
pieces = []
started = False
for l in region:
    full = len(l.rstrip()) >= width - 2
    if not started:
        m = re.match(r"^[❯>]\s?(.*)$", l)
        if m:
            started = True
            pieces.append((m.group(1).rstrip(), full))
    else:
        t = l.rstrip()
        if t.startswith("  "):
            t = t[2:]
        pieces.append((t, full))
out = []
for text, full in pieces:
    if not text:
        continue
    out.append(text)
    out.append("" if full else " ")
print("".join(out).strip())
'
}

read_box() { "$CMUX_BIN" read-screen --surface "$1" 2>/dev/null | parse_input_box; }

# Is what the box shows the text OUR last attempt typed and then abandoned?
# The divergence branch of deliver_once leaves it there on purpose (so the
# user can just press Enter), and the "never clobber a draft" guard then read
# it back as a foreign draft and held off on every tick — for 8 hours, live
# in production. Worse, the retry that would have counted a strike and parked
# the line could never run, so the escape hatch built for exactly this case
# was unreachable. The record makes our own leftovers recognisable.
box_is_leftover() {  # $1 = surface, $2 = queued line, $3 = current box
  local lfile="$QDIR/$1.leftover"
  [ -f "$lfile" ] || return 1
  [ "$(sed -n 1p "$lfile")" = "$2" ] || { rm -f "$lfile"; return 1; }
  [ "$(sed -n '2,$p' "$lfile")" = "$3" ]
}

# One notification per blocked line. A draft sitting in the input box stops
# delivery for as long as it is there, which is correct, but the only sign of
# it used to be the statusline row — easy to miss for a whole night.
holdoff_warn() {  # $1 = surface, $2 = queued line
  local hfile="$QDIR/$1.holdoff"
  if [ "$(sed -n 1p "$hfile" 2>/dev/null)" != "$2" ]; then
    printf '%s\n' "$2" > "$hfile"   # first hold-off for this line: stamp it
  elif [ "$(sed -n 2p "$hfile" 2>/dev/null)" != "notified" ] \
       && [ -z "$(/usr/bin/find "$hfile" -newermt '-10 minutes' 2>/dev/null)" ]; then
    log "deliver surface=$1 blocked 10 min by a draft in the box, notifying"
    "$CMUX_BIN" notify --title "Queue blocked" \
      --body "A queued prompt cannot be delivered: a draft is sitting in the input box. Send or clear it." \
      --surface "$1" >/dev/null 2>&1
    printf '%s\nnotified\n' "$2" > "$hfile"
  fi
}

# Is what the input box shows a Claude Code prompt SUGGESTION rather than a
# typed draft? The suggestion scrapes exactly like a draft (same ❯ prefix; no
# style attribute survives read-screen), but it is display-only over an EMPTY
# buffer: after typing one character the box holds just that character, while
# a real draft holds draft+char. The backspace undoes the probe either way (a
# suggestion simply re-renders on the empty box). Only safe on an idle
# session, where a stray keystroke cannot steer a running turn.
box_is_ghost() {
  local probe=""
  "$CMUX_BIN" send --surface "$1" "x" >>"$QDIR/log.txt" 2>&1 || return 1
  sleep 0.3
  probe=$(read_box "$1")
  "$CMUX_BIN" send-key --surface "$1" backspace >>"$QDIR/log.txt" 2>&1
  [ "$probe" = "x" ]
}

# One-shot context read for capture, optimized for latency (the user just hit
# the hotkey and is waiting for the box to clear): store + events tail +
# read-screen + input-box parse, all in a SINGLE python process — interpreter
# startup dominates this path on a loaded machine, so one process, not four.
# Prints "<target>\x1f<sid>\x1f<running 0/1>\x1f<draft text>"; empty target
# means the store has no session for this workspace (caller falls back to rpc).
capture_ctx() {
  python3 - "$STORE" "$1" "$EVENTS" "$CMUX_BIN" <<'PY' 2>/dev/null
import json, re, subprocess, sys
store, ws, events, cmux = sys.argv[1:5]
target = sid = text = ""
running = 0
try:
    d = json.load(open(store))
    s0 = d.get("activeSessionsByWorkspace", {}).get(ws, {}).get("sessionId") or ""
    if s0.startswith("claude-"):
        s0 = s0[7:]
    sess = d.get("sessions", {}).get(s0, {})
    if sess.get("surfaceId"):
        target, sid = sess["surfaceId"], s0
        if sess.get("agentLifecycle") == "running":
            running = 1
except Exception:
    pass
if sid and not running:
    # the store lags right after a submit; cross-check fresh hook events
    try:
        f = open(events, "rb")
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 2097152))
        needle = ("claude-" + sid).encode()
        last = b""
        for line in f.read().splitlines():
            if needle in line and (b"agent.hook.UserPromptSubmit" in line
                                   or b'"agent.hook.Stop"' in line):
                last = line
        if b"UserPromptSubmit" in last:
            running = 1
    except Exception:
        pass
if target:
    # scrape the draft off the input box: the region between the last two
    # full-width separator lines, minus the "❯ " prompt (same rules as
    # parse_input_box, inlined here to stay inside the one process)
    try:
        dump = subprocess.run([cmux, "read-screen", "--surface", target],
                              capture_output=True, text=True, timeout=5).stdout
        lines = dump.split("\n")
        seps = [i for i, l in enumerate(lines) if re.match(r"^\s*─{20,}\s*$", l)]
        if len(seps) >= 2:
            # width-aware wrap reconstruction, same rules as parse_input_box
            # (the old plain space-join here spliced spaces into wrapped URLs)
            width = len(lines[seps[-1]].rstrip())
            pieces, started = [], False
            for l in lines[seps[-2] + 1 : seps[-1]]:
                full = len(l.rstrip()) >= width - 2
                if not started:
                    m = re.match(r"^[❯>]\s?(.*)$", l)
                    if m:
                        started = True
                        pieces.append((m.group(1).rstrip(), full))
                else:
                    t = l.rstrip()
                    if t.startswith("  "):
                        t = t[2:]
                    pieces.append((t, full))
            out = []
            for t, full in pieces:
                if not t:
                    continue
                out.append(t)
                out.append("" if full else " ")
            text = "".join(out).strip()
    except Exception:
        pass
print(f"{target}\x1f{sid}\x1f{running}\x1f{text}")
PY
}

# The store's agentLifecycle lags a few seconds behind a prompt submit; the
# hook events in events.jsonl are fresh. Running = the session's newest
# UserPromptSubmit is younger than its newest Stop.
events_running() {
  local last
  last=$(tail -c 2097152 "$EVENTS" 2>/dev/null | grep -F "claude-$1" \
    | grep -E '"agent\.hook\.(UserPromptSubmit|Stop)"' | tail -n 1)
  case "$last" in *UserPromptSubmit*) return 0 ;; esac
  return 1
}

# Session id + turn verdict for a surface, in ONE python process (this runs on
# every delivery tick, and interpreter startup dominates on a loaded machine).
# Hook events are the primary truth (newest UserPromptSubmit vs Stop), BUT an
# Esc interrupt emits NO Stop hook, no sidebar update and no notification
# (verified in events.jsonl) — both the store and the events stay
# "running" forever. A hook-based running verdict with no sign of life for
# 30 s is therefore reported as "stale" and the caller re-checks the live TUI
# screen (30 s keeps the worst post-Esc stall short while still trusting fresh
# hook data). With no usable events the store's agentLifecycle decides.
#
# "Sign of life" is the newest hook event of ANY kind for the session, not the
# UserPromptSubmit itself: a long turn emits PreToolUse/Notification/... for
# minutes while its UserPromptSubmit ages out, and dating the staleness clock
# from the submit declared every such turn "stale" after 30 s — the verdict
# then rested entirely on the TUI spinner regex, which misses shapes it has
# never seen. Hit live: a 20-minute turn (last submit 15:29:51,
# PreToolUse at 15:50:31) was judged idle at 15:50:32, the delivery went into
# Claude Code's own mid-turn queue and the prompt reached Claude twice.
# Prints "<sid>\x1f<idle|running|stale>".
session_state() {
  python3 - "$STORE" "$1" "$EVENTS" <<'PY' 2>/dev/null
import datetime, json, sys
store, surface, events = sys.argv[1:4]
sid = ""
lifecycle = "unknown"
try:
    d = json.load(open(store))
    sid = d.get("activeSessionsBySurface", {}).get(surface, {}).get("sessionId") or ""
    if sid.startswith("claude-"):
        sid = sid[7:]
    lifecycle = d.get("sessions", {}).get(sid, {}).get("agentLifecycle", "unknown")
except Exception:
    pass
verdict = "unknown"
if sid:
    needle = ("claude-" + sid).encode()
    last = None   # newest decisive event: UserPromptSubmit or Stop
    beat = None   # newest hook event of any kind = the session is still alive
    try:
        f = open(events, "rb")
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 2097152))
        for line in f.read().splitlines():
            if needle not in line or b'"agent.hook.' not in line:
                continue
            try:
                e = json.loads(line)
            except Exception:
                continue
            name = e.get("name") or ""
            if not name.startswith("agent.hook.") \
               or (e.get("payload") or {}).get("session_id") != needle.decode():
                continue
            beat = e
            if name in ("agent.hook.UserPromptSubmit", "agent.hook.Stop"):
                last = e
    except Exception:
        pass
    if last is not None:
        if last["name"] == "agent.hook.Stop":
            verdict = "idle"
        else:
            try:
                # beat is never older than last (the log is append-ordered);
                # if it somehow were, the larger age only biases toward the
                # screen re-check, which is the safe direction
                ts = datetime.datetime.fromisoformat(
                    ((beat or last).get("occurred_at") or "").replace("Z", "+00:00"))
                age = (datetime.datetime.now(datetime.timezone.utc) - ts).total_seconds()
            except Exception:
                age = 0
            verdict = "running" if age < 30 else "stale"
if verdict == "unknown":
    verdict = "running" if lifecycle == "running" else "idle"
print(sid + "\x1f" + verdict)
PY
}

# Claude Code's transcript for a session, if it is on disk. The directory name
# encodes the cwd, which we do not know here, so the session id is matched
# across all of them — session ids are UUIDs, so at most one can hit.
transcript_path() {
  local f
  for f in "$HOME/.claude/projects"/*/"$1.jsonl"; do
    [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# Python source shared by transcript_confirm and confirm_wait: does the tail
# of a Claude Code transcript jsonl hold a user message matching `want` at or
# after epoch `since`? They run as two separate one-shot python processes —
# confirm_wait must stay a single process across its whole poll loop (see
# below), so it cannot just shell out to transcript_confirm on every retry —
# so a plain function definition cannot be shared between them; this is
# injected into each heredoc instead, via an env var and exec().
IFS= read -r -d '' TRANSCRIPT_MATCH_PY <<'PYFRAG' || :
def transcript_match(path, want, since):
    if not path:
        return False
    # The prefilter runs against the RAW json line, where the prompt text is
    # escaped. Built from the unescaped text it could never match a prompt
    # holding a quote (or a backslash, or a newline) in its first 60 bytes:
    # no such prompt was confirmable, so the queue kept resending it until
    # the send ceiling parked it. Hit live on a 383-char prompt
    # whose 46th byte was a typographic quote.
    needle = json.dumps(want, ensure_ascii=False)[1:-1].encode("utf-8", "replace")[:60]
    # Walk backwards in blocks rather than reading a fixed-size tail. A media
    # heavy session writes tool results measured in hundreds of megabytes
    # (480 MB seen live) and the entry to confirm sat 14 MB from the end,
    # outside the old 4 MiB window — the confirmation was impossible for the
    # same reason twice over. The scan stops at the first block whose oldest
    # timestamp predates the bound, so an old `since` costs a few blocks and
    # not a full-file read on every tick; MAX_SCAN caps it either way.
    BLOCK = 4194304
    MAX_SCAN = 67108864
    try:
        since_iso = datetime.datetime.fromtimestamp(
            since - 300, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S").encode()
    except Exception:
        since_iso = b""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            pos = f.tell()
            carry = b""          # head of the block above, cut by the edge
            scanned = 0
            while pos > 0 and scanned < MAX_SCAN:
                start = max(0, pos - BLOCK)
                f.seek(start)
                block = f.read(pos - start) + carry
                scanned += pos - start
                pos = start
                lines = block.split(b"\n")
                carry = lines.pop(0) if pos > 0 else b""
                for raw in reversed(lines):
                    if needle not in raw:
                        continue
                    try:
                        d = json.loads(raw)
                    except Exception:
                        continue
                    if d.get("type") != "user":
                        continue
                    c = (d.get("message") or {}).get("content")
                    if isinstance(c, str):
                        text = c
                    elif isinstance(c, list):
                        text = "".join(b.get("text", "") for b in c
                                       if isinstance(b, dict) and b.get("type") == "text")
                    else:
                        continue
                    if text != want:
                        continue
                    try:
                        ts = datetime.datetime.fromisoformat(
                            (d.get("timestamp") or "").replace("Z", "+00:00")).timestamp()
                    except Exception:
                        continue
                    if ts >= since:
                        return True
                # entries are appended in time order, so the first timestamp
                # in a block is the oldest in it: one find and one compare
                # per 4 MiB decides whether anything older can still qualify
                if since_iso:
                    i = block.find(b'"timestamp":"')
                    if i >= 0 and block[i + 13:i + 13 + len(since_iso)] < since_iso:
                        break
    except Exception:
        return False
    return False
PYFRAG

# The workspace a session belongs to, from the cmux hook store.
session_workspace() {  # $1 = session id
  plutil -extract "sessions.$1.workspaceId" raw -o - -- "$STORE" 2>/dev/null \
    || plutil -extract "sessions.claude-$1.workspaceId" raw -o - -- "$STORE" 2>/dev/null
}

# Did cmux itself record a prompt submit for this session's workspace at or
# after epoch $3, matching the queued line? Unlike tool_input_length (see
# confirm_submit) the workspace.prompt.submitted event carries the first 240
# characters of the text, so it does not saturate and is the only event-log
# signal that can identify a LONG prompt. It is the fallback for sessions
# whose transcript is missing, unreadable or past MAX_SCAN.
#
# The event names no surface, only a workspace, so two Claude sessions in one
# workspace are indistinguishable here. A truncated preview makes that
# harmless (240 shared leading characters is not a collision anyone hits); an
# untruncated one must equal the line exactly, never merely prefix it — a
# short foreign submit that happens to start our line must not confirm it.
preview_confirm() {  # $1 = session id, $2 = line, $3 = since (epoch)
  local wsid
  wsid=$(session_workspace "$1") || return 1
  [ -n "$wsid" ] || return 1
  python3 - "$EVENTS" "$wsid" "$2" "$3" <<'PY' 2>/dev/null
import datetime, json, sys
events, wsid, want, since = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4])
try:
    with open(events, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 4194304))
        chunk = f.read()
except Exception:
    sys.exit(1)
key = wsid.encode()
for raw in chunk.split(b"\n"):
    if b"workspace.prompt.submitted" not in raw or key not in raw:
        continue
    try:
        d = json.loads(raw)
    except Exception:
        continue
    if d.get("name") != "workspace.prompt.submitted":
        continue
    p = d.get("payload") or {}
    if p.get("workspace_id") != wsid:
        continue
    prev = p.get("message_preview") or ""
    if prev.endswith("\u2026"):
        head = prev[:-1]
        if not head or len(want) <= len(head) or not want.startswith(head):
            continue
    elif prev != want:
        continue
    try:
        ts = datetime.datetime.fromisoformat(
            (d.get("occurred_at") or "").replace("Z", "+00:00")).timestamp()
    except Exception:
        continue
    if ts >= since:
        sys.exit(0)
sys.exit(1)
PY
}

# Was EXACTLY this prompt submitted to this session at or after epoch $3?
# The timestamp bound is what makes it safe: the same text may well have been
# sent before (a repeat is ordinary), and confirming on an older copy would
# pop a line that never ran.
# 0 = confirmed, 1 = the transcript was readable and does not contain it,
# 2 = there is no transcript to ask. Only 2 may fall back to preview_confirm.
transcript_confirm() {
  local tf
  tf=$(transcript_path "$1") || return 2
  TRANSCRIPT_MATCH_PY="$TRANSCRIPT_MATCH_PY" python3 - "$tf" "$2" "$3" <<'PY' 2>/dev/null
import datetime, json, os, sys
exec(os.environ["TRANSCRIPT_MATCH_PY"])
path, want, since = sys.argv[1], sys.argv[2], float(sys.argv[3])
sys.exit(0 if transcript_match(path, want, since) else 1)
PY
}

# Epoch seconds of a file's mtime, or 0. Used as the "not before" bound for
# the transcript check: how long ago we typed the line.
#
# %Fm, not %m: whole seconds round the bound DOWN, below the marker's true
# write instant, so a transcript entry written a few milliseconds BEFORE the
# marker still satisfies "at or after it". The marker is rewritten right after
# the submit it is meant to postdate, so that is the ordinary case, not a
# rare one — and it would confirm the second copy of a deliberately repeated
# prompt against the first copy's entry and pop it unsent.
mtime_epoch() { /usr/bin/stat -f %Fm "$1" 2>/dev/null || echo 0; }

# Did a UserPromptSubmit for this session land in events.jsonl after byte
# offset $2? With $4 = strict, additionally require tool_input_length to match
# the queued line (the payload redacts the prompt text but keeps the length of
# its {"prompt": ...} JSON), so a foreign submit does not count. With $4 =
# near, allow the submit to be up to 4 bytes LONGER than the queued line: the
# box scrape strips trailing whitespace, so a copy of the same draft submitted
# by the TUI itself can come out slightly longer than what was scraped.
#
# Claude Code's own transcript is the authoritative source and is checked
# first: cmux's tool_input_length SATURATES for long prompts. Measured
# on three unrelated prompts of 287, 727 and 17107 characters —
# reported 254, 253 and 263. Every prompt over roughly 250 characters is
# therefore unidentifiable in the event log, so no long delivery could ever be
# confirmed: the line stayed queued and went out again on every tick. Five
# copies of one prompt reached Claude before this was found. Short prompts
# still match exactly (49, 104, 122 verified), so the event check is kept as
# the fallback for them and for sessions with no transcript on disk.
confirm_submit() {
  local sid="$1" offset="$2" line="$3" strict="${4:-loose}" since="${5:-0}"
  local tc
  transcript_confirm "$sid" "$line" "$since"; tc=$?
  [ "$tc" -eq 0 ] && return 0
  # preview_confirm names a workspace and no surface (cmux leaves surface_id
  # null on workspace.prompt.submitted), so two Claude panes sharing one
  # workspace are indistinguishable there, and a short prompt submitted in the
  # other pane matches this one exactly. Ask it only when the transcript could
  # not answer at all — the case it was written for.
  [ "$tc" -eq 2 ] && preview_confirm "$sid" "$line" "$since" && return 0
  # a rotated event log (cmux renames it to events.jsonl.1 at 16 MB) leaves
  # every stored offset past the end of the new file, where tail reads nothing
  [ "$offset" -gt "$(wc -c < "$EVENTS" 2>/dev/null || echo 0)" ] 2>/dev/null && offset=0
  tail -c "+$((offset + 1))" "$EVENTS" 2>/dev/null | python3 -c '
import json, sys
sid, text, mode = sys.argv[1], sys.argv[2], sys.argv[3]
# cmux serializes tool_input compactly: {"prompt":"..."} with no spaces
lens = {len(json.dumps({"prompt": text}, separators=(",", ":"))),
        len(json.dumps({"prompt": text}, separators=(",", ":"), ensure_ascii=False))}
for raw in sys.stdin:
    if "UserPromptSubmit" not in raw or sid not in raw:
        continue
    try:
        d = json.loads(raw)
    except Exception:
        continue
    if d.get("name") != "agent.hook.UserPromptSubmit":
        continue
    p = d.get("payload") or {}
    if p.get("session_id") != sid:
        continue
    til = p.get("tool_input_length")
    if mode == "strict" and til not in lens:
        continue
    if mode == "near" and not (isinstance(til, int)
                               and any(n <= til <= n + 4 for n in lens)):
        continue
    sys.exit(0)
sys.exit(1)' "claude-$sid" "$line" "$strict"
}

# Wait up to ~6 s for the submit confirmation, polling inside ONE python
# process. Always strict (length match): a loose "any submit counts" check
# let a foreign submit inside the window confirm a delivery whose keys never
# landed — the queued line was then popped without ever running. The old
# shell loop also spawned a fresh interpreter every 0.5 s, up to 12 per
# delivery, each 20-300 ms of startup under load.
#
# $4 = the transcript to watch alongside the events (empty if there is none).
# Long prompts are invisible in the event log — see confirm_submit — so for
# them the transcript is the only signal that can ever fire here.
confirm_wait() {
  TRANSCRIPT_MATCH_PY="$TRANSCRIPT_MATCH_PY" \
    python3 - "$EVENTS" "claude-$1" "$2" "$3" "$(transcript_path "$1" || true)" \
    <<'PY' 2>/dev/null
import datetime, json, os, sys, time
exec(os.environ["TRANSCRIPT_MATCH_PY"])
events, sid, offset, text = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
tpath = sys.argv[5]
# taken here rather than passed in: this runs immediately after the Enter, and
# a shell `date +%s` would round down to the top of its second, widening the
# window into prompts submitted before ours
since = time.time() - 2   # slack: the two clocks are not the same

lens = {len(json.dumps({"prompt": text}, separators=(",", ":"))),
        len(json.dumps({"prompt": text}, separators=(",", ":"), ensure_ascii=False))}
deadline = time.monotonic() + 6.0
pos = offset
while True:
    if transcript_match(tpath, text, since):
        sys.exit(0)
    try:
        with open(events, "rb") as f:
            f.seek(0, 2)
            if f.tell() < pos:   # the log rotated under us; start over
                pos = 0
            f.seek(pos)
            chunk = f.read()
    except Exception:
        chunk = b""
    if chunk:
        nl = chunk.rfind(b"\n")  # complete lines only; tail re-read next poll
        if nl >= 0:
            for raw in chunk[:nl].splitlines():
                if b"UserPromptSubmit" not in raw or sid.encode() not in raw:
                    continue
                try:
                    d = json.loads(raw)
                except Exception:
                    continue
                p = d.get("payload") or {}
                if d.get("name") == "agent.hook.UserPromptSubmit" \
                   and p.get("session_id") == sid \
                   and p.get("tool_input_length") in lens:
                    sys.exit(0)
            pos += nl + 1
    if time.monotonic() >= deadline:
        sys.exit(1)
    time.sleep(0.4)
PY
}

# Queue files are appended by capture/add/enqueue and rewritten by the
# delivery pop; an append landing between the pop's read and its rename
# would vanish with the rewritten file. This tiny lock serializes just those
# few milliseconds on both sides. A holder can be SIGKILLed at any line, so
# a lock older than 5 s is stolen.
qlock_take() {
  local ql="$QDIR/$1.qlock" tries=0 stole=""
  until mkdir "$ql" 2>/dev/null; do
    if [ -z "$(/usr/bin/find "$ql" -newermt '-5 seconds' 2>/dev/null)" ]; then
      rm -rf "$ql"
      stole=1
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -ge 20 ] && return 1
    sleep 0.05
  done
  # An uncontended mkdir is atomic and needs nothing more. Breaking a stale
  # lock is not: a second breaker removes the directory we just created and
  # makes its own, and both proceed to rewrite the queue file at once, which
  # is how a concurrent append disappears. Stamp and re-read, so the loser
  # backs off. Only the crash-recovery path pays the settle.
  if [ -n "$stole" ]; then
    printf '%s\n' "$$" > "$ql/owner" 2>/dev/null
    sleep 0.05
    [ "$(cat "$ql/owner" 2>/dev/null)" = "$$" ] || return 1
  fi
  return 0
}
qlock_drop() { rm -rf "$QDIR/$1.qlock"; }

# Drop the head of the queue, but ONLY if it is still the line the caller
# handled. The queue manager can delete or edit the head while a delivery is
# in flight (it has no way to see one in progress), and an unconditional
# `tail -n +2` would then discard whatever moved up into its place — a prompt
# the user queued and never got. Callers already hold the qlock.
pop_head() {  # $1 = surface, $2 = the line expected at the head
  local qfile="$QDIR/$1.queue"
  [ "$(head -n 1 "$qfile" 2>/dev/null)" = "$2" ] || return 1
  tail -n +2 "$qfile" > "$qfile.tmp" 2>/dev/null && mv "$qfile.tmp" "$qfile"
}

qinode() { /usr/bin/stat -f %i "$QDIR/$1.queue" 2>/dev/null; }

# Is the attempt record still about the line currently at the head of the
# queue? Both delivery guards that read it (late-confirm, in-flight) must fire
# for the instance they were written for and for no other.
#
# The discriminator is the queue file's inode, recorded as line 3 of the
# record. Every pop and every manager edit replaces the file via mv, so the
# inode changes; every enqueue appends, so it does not. That is exactly the
# question being asked — "has the head line been popped since this attempt?"
# The mtime comparison it replaces could not answer it: ANY append made the
# queue newer than the record and disarmed both guards, and queueing more
# prompts during a long turn is this tool's main use case. Hit live: prompt A
# sat in Claude Code's own mid-turn queue, the user queued B, and A was sent
# to Claude a second time.
#
# A record from before the inode field simply does not match (line 3 is
# empty), so an upgrade with a delivery in flight resends once instead of
# holding off. Falling back to the old mtime test here would have kept the
# duplicate alive for exactly the records most likely to hit it; the case is
# already covered independently by the qoffset "already submitted since
# enqueue" check below, which reads the event log and needs no record at all.
attempt_live() {  # $1 = surface, $2 = current head line
  local afile="$QDIR/$1.attempt" want
  [ -f "$afile" ] || return 1
  [ "$(sed -n 2p "$afile")" = "$2" ] || return 1
  want=$(sed -n 3p "$afile")
  [ -n "$want" ] && [ "$want" = "$(qinode "$1")" ]
}
attempt_write() {  # $1 = surface, $2 = events offset, $3 = line
  { printf '%s\n' "$2"; printf '%s\n' "$3"; printf '%s\n' "$(qinode "$1")"; } \
    > "$QDIR/$1.attempt"
}

# Replace (with $4 set) or delete (without) queue item $2 of surface $1, but
# only if it still holds $3 — a delivery may pop or reorder the file between
# the manager's render and the user's keypress, and a blind index write would
# then hit the wrong line. Returns 1 when the file changed underneath.
queue_mutate() {
  local surface="$1" idx="$2" expected="$3" new="${4-}"
  local qfile="$QDIR/$surface.queue" i=0 l changed=""
  qlock_take "$surface" || return 1
  : > "$qfile.tmp"
  while IFS= read -r l; do
    if [ "$i" = "$idx" ] && [ "$l" = "$expected" ]; then
      changed=1
      [ -n "$new" ] && printf '%s\n' "$new" >> "$qfile.tmp"
    else
      printf '%s\n' "$l" >> "$qfile.tmp"
    fi
    i=$((i + 1))
  done < "$qfile" 2>/dev/null
  if [ -n "$changed" ]; then
    mv -f "$qfile.tmp" "$qfile"
  else
    rm -f "$qfile.tmp"
  fi
  qlock_drop "$surface"
  [ -n "$changed" ]
}

# Try to deliver the first queued line for a surface. Lock-guarded so capture,
# the notification hook and a manual drain never double-deliver. Returns 0 when
# the line was confirmed delivered, 1 otherwise (line stays queued for the next
# trigger). Keystroke injection can fail or be silently dropped (e.g. while the
# user interacts with the app), so a submission only counts once a matching
# UserPromptSubmit shows up in events.jsonl.
deliver_once() {
  local surface="$1"
  local qfile="$QDIR/$surface.queue"
  local lock="$QDIR/$surface.lock"
  local afile="$QDIR/$surface.attempt"
  local line box sid ctx verdict offset delivered oldpid is_slash ghost screen
  local sfile scount sprev

  [ -s "$qfile" ] || return 0

  # Atomic lock with the owner pid embedded: ln -s creates name and content
  # in one syscall, so the lock can never exist without a readable owner.
  # (The old mkdir + pid-file scheme had a window before the pid write where
  # a second hook read an empty pid, judged the lock stale and stole it —
  # two deliverers typing into the same surface at once.)
  if ! ln -s "$$" "$lock" 2>/dev/null; then
    oldpid=$(readlink "$lock" 2>/dev/null || true)
    if [ -n "$oldpid" ] && kill -0 "$oldpid" 2>/dev/null; then
      return 1  # someone else is delivering right now
    fi
    rm -rf "$lock"
    ln -s "$$" "$lock" 2>/dev/null || return 1
    # Reclaiming a stale lock is NOT atomic. A second recoverer that saw the
    # same dead owner deletes the lock we just made and puts its own there,
    # and both then believe they hold it — two deliverers typing the same
    # line into the same surface. Settle and confirm ownership; the loser
    # waits for the next tick. Only the crash-recovery path pays this.
    sleep 0.05
    [ "$(readlink "$lock" 2>/dev/null)" = "$$" ] || return 1
  fi
  # no RETURN trap here: it would fire on every nested function return; a stale
  # lock after a crash is recovered by the pid-liveness check above

  # the head is read under the lock: read earlier, a concurrent deliverer may
  # pop meanwhile and this process would resend the popped line and then pop
  # its unseen successor (duplicate + loss)
  line=$(head -n 1 "$qfile" 2>/dev/null || true)
  [ -z "$line" ] && { rm -rf "$lock"; return 0; }

  # parked by the send ceiling below: this exact line is not to be typed again
  if [ -f "$QDIR/$surface.parked" ]; then
    if [ "$(sed -n 1p "$QDIR/$surface.parked")" = "$line" ]; then
      rm -rf "$lock"; return 1
    fi
    rm -f "$QDIR/$surface.parked"   # the head moved on
  fi

  # Slash commands (/compact, /clear, skill invocations...) are handled inside
  # the Claude Code TUI and emit no UserPromptSubmit event, so the event-log
  # confirm can never succeed for them — the pump would resubmit the command
  # every tick forever (hit live: /compact resent 14x). They are confirmed by
  # box state instead, below. A first token with a second slash or a character
  # commands never contain is a path or plain text, not a command.
  is_slash=""
  case "${line%% *}" in
    /*/*|/*[!A-Za-z0-9:_-]*) : ;;
    /?*) is_slash=1 ;;
  esac

  ctx=$(session_state "$surface")
  sid=${ctx%%$'\x1f'*}
  verdict=${ctx#*$'\x1f'}
  if [ -z "$sid" ]; then
    # without a session id we can neither check running-state nor confirm a
    # submit — sending keys blind risks steering; wait for a later tick
    log "deliver surface=$surface no session registered yet, waiting"
    rm -rf "$lock"; return 1
  fi
  # A previous attempt may have already submitted this line: either a late
  # submit (keystrokes sent while the TUI executes a deferred ! command buffer
  # up and only submit a turn later), or a confirmed delivery whose queue pop
  # was killed before it landed (cmux reaps hook processes when their
  # notification clears — hit live: the kill fell between tail and mv and the
  # line was re-sent 14 s later as a duplicate). If a submit matching the line
  # landed since that attempt, pop it without sending the keys again. The
  # marker is only honored while it is newer than the queue file: a LATER
  # append means the head line is a fresh, intentional re-queue of the same
  # text and must be sent normally, not swallowed by an old confirmation.
  # For a slash command the record alone is trusted — no event will ever
  # exist, and the record is only written after the box-cleared confirmation.
  if [ -n "$sid" ] && attempt_live "$surface" "$line" \
     && { [ -n "$is_slash" ] \
          || confirm_submit "$sid" "$(sed -n 1p "$afile")" "$line" strict \
                            "$(mtime_epoch "$afile")"; }; then
    log "deliver surface=$surface late-confirmed, not resending: $line"
    if qlock_take "$surface"; then
      pop_head "$surface" "$line" \
        && rm -f "$afile" "$QDIR/$surface.sends" "$QDIR/$surface.parked" \
                 "$QDIR/$surface.leftover" "$QDIR/$surface.holdoff"
      wc -c < "$EVENTS" > "$QDIR/$surface.qoffset" 2>/dev/null
      qlock_drop "$surface"
    fi
    rm -rf "$lock"
    return 0
  fi

  # The queued text may have already been submitted WITHOUT us (hit live):
  # a plain Enter racing the Opt+Enter puts the draft into Claude Code's own
  # native queued-messages buffer, which auto-submits it at turn end — our
  # scraped copy would then go out a second time. If a near-matching submit
  # landed since this queue became non-empty, pop instead of resending.
  qoff=$(cat "$QDIR/$surface.qoffset" 2>/dev/null)
  if [ -n "$qoff" ] && confirm_submit "$sid" "$qoff" "$line" near \
                                      "$(mtime_epoch "$QDIR/$surface.qoffset")"; then
    log "deliver surface=$surface already submitted since enqueue, popping without resend: $line"
    if qlock_take "$surface"; then
      pop_head "$surface" "$line"
      rm -f "$QDIR/$surface.sends" "$QDIR/$surface.parked" \
            "$QDIR/$surface.leftover" "$QDIR/$surface.holdoff"
      wc -c < "$EVENTS" > "$QDIR/$surface.qoffset" 2>/dev/null
      qlock_drop "$surface"
    fi
    rm -rf "$lock"
    return 0
  fi

  case "$verdict" in
    running) rm -rf "$lock"; return 1 ;;
    stale|idle)
      # "idle" is not positive evidence of an input box. session_state only
      # sees the last 2 MiB of events.jsonl, so a session whose events aged
      # out — or that was there when the log rotated — resolves to unknown,
      # and unknown with a non-running lifecycle becomes idle. needsInput (a
      # pending permission dialog) lands here too. Both get the same screen
      # check as stale, because an Enter into a dialog answers the dialog.
      #
      # "stale": hooks say running but nothing landed for 30+ s: either a long
      # tool-less streaming stretch (still running) or an Esc interrupt
      # (idle). Only the TUI live-status line tells them apart — it exists
      # while a turn streams or runs tools, in several shapes:
      #   "✳ Verb… (2m 17s · ↓ 7.8k tokens · thought for 6s)"  main spinner
      #   "(3s · esc to interrupt)"                             early form
      #   "◯ general-purpose  Doing X … 6m 57s · ↓ 110.0k tokens"  subagent,
      #                                            NO parentheses (hit live)
      # also refuse on a pending tool-permission dialog: it renders with no
      # spinner or timer, and an Enter sent into it would answer the dialog
      # a screen we cannot read is not a screen without a spinner: an empty
      # read-screen used to fall through the regex and be taken as "idle"
      screen=$("$CMUX_BIN" read-screen --surface "$surface" 2>/dev/null)
      [ -z "$screen" ] && { rm -rf "$lock"; return 1; }
      if printf '%s' "$screen" | python3 -c '
import re, sys
sys.exit(0 if re.search(r"esc to interrupt|\(\d+m? ?\d*s\s*·|\d+m? ?\d*s\s*·\s*[↓↑]|Do you want to|don.t ask again", sys.stdin.read()) else 1)
'; then rm -rf "$lock"; return 1; fi ;;
  esac

  # never clobber a draft the user is typing
  ghost=""
  box=$(read_box "$surface")
  if [ -n "$box" ] && [ "$box" != "$line" ]; then
    if box_is_leftover "$surface" "$line" "$box"; then
      # not a draft, our own abandoned attempt: clear it and try again, so a
      # second divergence counts a strike and the park below can be reached
      log "deliver surface=$surface box holds our own abandoned attempt, retrying"
    elif ! box_is_ghost "$surface"; then
      log "deliver surface=$surface holding off, user draft in box"
      holdoff_warn "$surface" "$line"
      rm -rf "$lock"
      return 1
    else
      log "deliver surface=$surface box content is a ghost suggestion, proceeding"
      # remember it: a suggestion sits over an EMPTY buffer, and every later
      # "does the box still hold our line?" test must read it as empty. Claude
      # Code suggests the previous prompt, which after a delivery is our own
      # line — read literally, that says "the keys never landed", and the line
      # goes out again. Every 15 s (hit live, five copies).
      ghost=1
    fi
  fi
  rm -f "$QDIR/$surface.holdoff"

  # A submit already in flight. Our previous attempt typed this exact line and
  # the box no longer holds it, yet no matching UserPromptSubmit has landed.
  # From outside, that is exactly what Claude Code's OWN mid-turn queue looks
  # like: it accepts the Enter and emits no hook at all until it drains at the
  # end of the turn (measured 59 s on a live session, against a 6 s confirm
  # window). Sending again here is how one prompt reaches Claude twice — hit
  # live, the same line submitted at 15:56:02 and 15:56:03. Hold off instead
  # and let the late-confirm path above pop it once the event finally lands.
  # The age bound is the escape hatch: if no event has appeared in ten minutes
  # the keystrokes really are gone, and a resend (with its strike) is right.
  if [ -n "$sid" ] && attempt_live "$surface" "$line" \
     && [ -n "$(/usr/bin/find "$afile" -newermt '-10 minutes' 2>/dev/null)" ]; then
    box=$(read_box "$surface")
    [ -n "$ghost" ] && box=""
    if box_is_leftover "$surface" "$line" "$box"; then
      # the box holds what our last attempt typed and abandoned BEFORE the
      # Enter, so nothing can be in flight — treat it as keys that never
      # landed and retry now, instead of waiting out the ten-minute bound
      log "deliver surface=$surface abandoned attempt still in the box, not in flight"
    else
    case "$box" in
      "$line"*)
        # The box shows our line — but Claude Code suggests the prompt it just
        # accepted, so this is exactly what a delivered line looks like too.
        # Taken literally it reads as "the keys never landed" and the line
        # goes out again on every tick, forever. Probe before believing it.
        if box_is_ghost "$surface"; then
          log "deliver surface=$surface box shows a suggestion of our own line, submit in flight, not resending: $line"
          rm -rf "$lock"
          return 1
        fi ;;      # a real draft holding our text: the keys never landed
      *)
        log "deliver surface=$surface submit in flight (accepted, no event yet), not resending: $line"
        rm -rf "$lock"
        return 1 ;;
    esac
    fi
  fi

  # Hard ceiling on how many times ONE line may ever be typed into a session,
  # counted here — at the only place keys go out — and independent of every
  # confirmation heuristic above. Those heuristics have now failed twice in
  # ways nobody predicted (a mid-turn queue that emits no event; a prompt too
  # long for cmux to report a usable length), and each time the result was the
  # same prompt delivered over and over. Whatever the next surprise is, it
  # stops here. Parking, not dropping: the line stays queued and visible, and
  # the user decides — losing a prompt is as unacceptable as repeating one.
  sfile="$QDIR/$surface.sends"
  scount=1
  if [ -f "$sfile" ] && [ "$(sed -n 2p "$sfile")" = "$line" ]; then
    sprev=$(sed -n 1p "$sfile")
    case "$sprev" in *[!0-9]*|'') sprev=0 ;; esac
    scount=$((sprev + 1))
  fi
  if [ "$scount" -gt 3 ]; then
    printf '%s\n' "$line" > "$QDIR/$surface.parked"
    log "deliver surface=$surface PARKED after 3 sends without confirmation, not sending again: $line"
    "$CMUX_BIN" notify --title "Queue paused" \
      --body "A queued prompt was sent 3x without confirmation. It is still queued; check the session." \
      --surface "$surface" >/dev/null 2>&1
    rm -rf "$lock"
    return 1
  fi
  { printf '%s\n' "$scount"; printf '%s\n' "$line"; } > "$sfile"

  offset=$(wc -c < "$EVENTS" 2>/dev/null || echo 0)
  "$CMUX_BIN" send --surface "$surface" $'\x15' >>"$QDIR/log.txt" 2>&1 || {
    # surface gone or rejecting input (cmux restart, closed pane): skip the
    # whole confirm cycle instead of burning ~7 s against it every tick
    log "deliver surface=$surface send clear failed, skipping"
    rm -rf "$lock"
    return 1
  }
  "$CMUX_BIN" send --surface "$surface" -- "$line" >>"$QDIR/log.txt" 2>&1 \
    || log "deliver surface=$surface send text rc=$?"
  # Verify the box holds exactly what was typed before committing the Enter:
  # keystrokes the user typed into the send gap would otherwise be submitted
  # inside the queued prompt (worst failure mode). The read also serves as
  # the settle delay the old blind sleep provided. A partially rendered box
  # shows as a prefix of the line and is accepted; anything else aborts and
  # leaves the typed text visible in the box for the user to resolve.
  box=$(read_box "$surface")
  case "$line" in
    "$box"*) : ;;
    *)
      log "deliver surface=$surface box diverged after typing, not submitting"
      # what stays in the box is ours; without this record the guard above
      # would read it as a user draft and never let the retry happen
      printf '%s\n%s\n' "$line" "$box" > "$QDIR/$surface.leftover"
      # retry cap: a line that keeps diverging (scrape imperfection on some
      # exotic rendering) must not fight the user forever. After 3 attempts
      # park it: the typed text stays visible in the box, the user just
      # presses Enter, and a notification says so.
      dfile="$QDIR/$surface.diverge"
      dcount=1
      if [ -f "$dfile" ] && [ "$(sed -n 2p "$dfile")" = "$line" ]; then
        prev=$(sed -n 1p "$dfile")
        case "$prev" in *[!0-9]*|'') prev=0 ;; esac
        dcount=$((prev + 1))
      fi
      if [ "$dcount" -ge 3 ]; then
        log "deliver surface=$surface parked after $dcount diverges, text left in box: $line"
        if qlock_take "$surface"; then
          pop_head "$surface" "$line"
          wc -c < "$EVENTS" > "$QDIR/$surface.qoffset" 2>/dev/null
          qlock_drop "$surface"
        fi
        rm -f "$dfile" "$QDIR/$surface.leftover"
        "$CMUX_BIN" notify --title "Queue" \
          --body "Delivery parked: the text is in the input box, press Enter to send it" \
          --surface "$surface" >/dev/null 2>&1
      else
        { printf '%s\n' "$dcount"; printf '%s\n' "$line"; } > "$dfile"
      fi
      rm -rf "$lock"
      return 1 ;;
  esac
  "$CMUX_BIN" send-key --surface "$surface" enter >>"$QDIR/log.txt" 2>&1 \
    || log "deliver surface=$surface send enter rc=$?"
  delivered=""
  if [ -n "$is_slash" ]; then
    # No event will ever confirm a slash command; confirm by box state: the
    # TUI clears the input box the moment Enter takes the command. The full
    # line (or a rendering prefix of it) still sitting there means Enter has
    # not landed; an empty or unrelated box means the TUI took it.
    for _ in 1 2 3; do
      sleep 1
      box=$(read_box "$surface")
      [ -z "$box" ] && { delivered=yes; break; }
      case "$line" in
        "$box"*) : ;;
        *) delivered=yes; break ;;
      esac
    done
  elif confirm_wait "$sid" "$offset" "$line"; then delivered=yes; fi

  if [ -n "$delivered" ]; then
    # Record the confirmed submit BEFORE popping: this process can be killed
    # on any line, and a confirmed-but-not-popped line would be re-sent as a
    # duplicate prompt. With the record, the next tick takes the late-confirm
    # path above and pops without resending.
    rm -f "$QDIR/$surface.diverge" "$QDIR/$surface.resend" \
          "$QDIR/$surface.sends" "$QDIR/$surface.parked" \
          "$QDIR/$surface.leftover" "$QDIR/$surface.holdoff"
    attempt_write "$surface" "$offset" "$line"
    if qlock_take "$surface"; then
      pop_head "$surface" "$line" \
        || log "deliver surface=$surface pop failed or head changed, next tick will late-confirm"
      # advance the enqueue offset past our own submit, so an identical line
      # queued next (intentional repeat) is not swallowed as already-sent
      wc -c < "$EVENTS" > "$QDIR/$surface.qoffset" 2>/dev/null
      qlock_drop "$surface"
    else
      log "deliver surface=$surface pop skipped (queue busy), next tick will late-confirm"
    fi
    log "deliver surface=$surface delivered: $line"
    rm -rf "$lock"
    return 0
  fi
  log "deliver surface=$surface not confirmed, keeping queued: $line"
  # the attempt record backs the late-confirm path, which for slash commands
  # trusts the record without an event — so for them it may only ever be
  # written by the confirmed branch above, never on a failed attempt
  if [ -z "$is_slash" ]; then
    attempt_write "$surface" "$offset" "$line"
    # Modern Claude Code has its OWN mid-turn queue: a submit that lands in it
    # fires no UserPromptSubmit until that queue drains at the end of the turn
    # — measured 59 s on a live session, against a 6 s confirm window. So an
    # unconfirmed send does not mean the keystrokes were lost. If our text is
    # gone from the box, the TUI has it, and a strike here would be unearned:
    # three of those drop a prompt the user really did send. Keep the line for
    # the late-confirm path, but do not count it against the cap. (Slash
    # commands already confirm this way; this is the same signal.)
    box=$(read_box "$surface")
    case "$box" in
      # a suggestion of the line we just sent looks identical to the line
      # never having been taken; only the probe tells them apart
      "$line"*) box_is_ghost "$surface" && box="" ;;
    esac
    case "$box" in
      "$line"*) : ;;   # still sitting there: Enter genuinely did not land
      *)
        log "deliver surface=$surface box no longer holds it, TUI accepted it (native queue) — no strike"
        rm -rf "$lock"
        return 1 ;;
    esac
  fi
  # Resend cap: a line that can never be confirmed must not be resubmitted
  # forever (the /compact loop was exactly that, before slash detection).
  # Each strike here means the text was fully typed, verified in the box and
  # Entered — after three of those, a fourth send is guaranteed spam: drop
  # the line (it stays in the log) and tell the user.
  rfile="$QDIR/$surface.resend"
  rcount=1
  if [ -f "$rfile" ] && [ "$(sed -n 2p "$rfile")" = "$line" ]; then
    rprev=$(sed -n 1p "$rfile")
    case "$rprev" in *[!0-9]*|'') rprev=0 ;; esac
    rcount=$((rprev + 1))
  fi
  if [ "$rcount" -ge 3 ]; then
    log "deliver surface=$surface dropped after $rcount unconfirmed sends: $line"
    if qlock_take "$surface"; then
      pop_head "$surface" "$line" \
        && rm -f "$rfile"
      wc -c < "$EVENTS" > "$QDIR/$surface.qoffset" 2>/dev/null
      qlock_drop "$surface"
    fi
    "$CMUX_BIN" notify --title "Queue" \
      --body "Prompt sent 3x without confirmation, removed from the queue (text is in the log)" \
      --surface "$surface" >/dev/null 2>&1
  else
    { printf '%s\n' "$rcount"; printf '%s\n' "$line"; } > "$rfile"
  fi
  rm -rf "$lock"
  return 1
}

cmd="${1:-capture}"

case "$cmd" in
  capture)
    # Instant statusline feedback: mark a capture in flight before any of the
    # slow socket work. While this file is fresh the statusline shows a
    # transient "⏳ Queuing…" row, which turns into the real queued row once
    # the draft lands in a queue file. Removed on every exit path (trap),
    # with a short mtime TTL in the statusline as the crash guard.
    cstamp="$QDIR/capturing.stamp"
    touch "$cstamp"
    trap 'rm -f "$cstamp"' EXIT
    ws="${CMUX_WORKSPACE_ID:-}"
    if [ -z "$ws" ]; then
      # invoked outside a cmux terminal (hotkey daemon): target the workspace
      # selected in the focused cmux window. plutil is a real JSON parser and
      # starts in single-digit milliseconds, unlike a python interpreter.
      ws=$("$CMUX_BIN" rpc workspace.current '{}' 2>/dev/null \
        | plutil -extract workspace.id raw -o - -- - 2>/dev/null)
    fi
    [ -z "$ws" ] && { log "capture: no workspace (not inside cmux, rpc failed)"; exit 1; }
    ctx=$(capture_ctx "$ws")
    IFS=$'\x1f' read -r target sid running text <<< "$ctx"
    if [ -z "$target" ]; then
      # store miss (e.g. right after a cmux restart): slow rpc fallback
      target=$(target_surface "$ws")
      sid=$(session_of "$target")
      running=0
      if [ "$(lifecycle "$target")" = "running" ] || { [ -n "$sid" ] && events_running "$sid"; }; then
        running=1
      fi
      text=$(read_box "$target")
    fi
    if [ -z "$target" ]; then
      "$CMUX_BIN" notify --title "Queue" --body "No Claude session found in this workspace" --workspace "$ws" >/dev/null 2>&1
      log "capture ws=$ws: no claude session"
      [ -n "$CLOSE_TAB" ] && "$CMUX_BIN" close-surface --surface "$CLOSE_TAB" >/dev/null 2>&1
      exit 0
    fi

    # narrow the transient row to the captured surface's own statusline; the
    # global stamp only covers the resolution window above (~0.3 s), so other
    # sessions barely flash it
    mv -f "$cstamp" "$QDIR/capturing-$target.stamp" 2>/dev/null
    cstamp="$QDIR/capturing-$target.stamp"

    if [ "$running" = "0" ]; then
      # Idle: no queueing needed, just submit the draft as-is and leave.
      if [ -n "$text" ]; then
        "$CMUX_BIN" rpc surface.focus "{\"surface_id\": \"$target\"}" >/dev/null 2>&1
        "$CMUX_BIN" send-key --surface "$target" enter >/dev/null 2>&1
        log "capture surface=$target idle, submitted draft: $text"
      fi
      [ -n "$CLOSE_TAB" ] && "$CMUX_BIN" close-surface --surface "$CLOSE_TAB" >/dev/null 2>&1
      exit 0
    fi

    # Turn in flight: clear the box, enqueue the draft, and hand focus back
    # to the Claude input as early as possible (right after the clear, so the
    # user's next keystrokes cannot race the snapshot). Slow tail work (log,
    # insurance tick, closing our own tab) happens after focus is returned.
    if [ -n "$text" ]; then
      # double-press guard: a second Opt+Enter can race the box clear and
      # scrape the same draft again (the TUI redraw lags the \x15 under
      # load). An identical line appended moments ago is that race, not an
      # intentional repeat — drop it. Deliberate re-queues arrive later.
      if [ -s "$QDIR/$target.queue" ] \
         && [ "$(tail -n 1 "$QDIR/$target.queue")" = "$text" ] \
         && [ -n "$(/usr/bin/find "$QDIR/$target.queue" -newermt '-3 seconds' 2>/dev/null)" ]; then
        log "capture surface=$target dropped double-press duplicate: $text"
        text=""
      else
        # record first, clear second: killed between the two, the draft is
        # both queued and still in the box — delivery treats box == line as
        # clear-and-resend, so nothing is lost. The old clear-first order
        # dropped the draft entirely if the append never ran.
        if qlock_take "$target"; then
          # first line into an empty queue: remember where the event log
          # stood, so delivery can tell "this text was already submitted
          # after it was queued" apart from any older identical submit
          [ -s "$QDIR/$target.queue" ] \
            || wc -c < "$EVENTS" > "$QDIR/$target.qoffset" 2>/dev/null
          printf '%s\n' "$text" >> "$QDIR/$target.queue"
          qlock_drop "$target"
        else
          # queue lock wedged: append unguarded — losing the draft is worse
          printf '%s\n' "$text" >> "$QDIR/$target.queue"
        fi
      fi
      # Ctrl+U alone only kills the current line of a multi-line draft; per
      # row: Ctrl+K, Ctrl+U, Backspace (join up) — all no-ops on an empty
      # box, so a blind 8-row overshoot is free (fallback path only; the
      # fast path counts the real rows)
      "$CMUX_BIN" send --surface "$target" $'\x0b\x15\x7f\x0b\x15\x7f\x0b\x15\x7f\x0b\x15\x7f\x0b\x15\x7f\x0b\x15\x7f\x0b\x15\x7f\x0b\x15\x7f' >/dev/null 2>&1
    fi
    "$CMUX_BIN" rpc surface.focus "{\"surface_id\": \"$target\"}" >/dev/null 2>&1
    if [ -n "$text" ]; then
      log "capture surface=$target queued: $text"
      # insurance tick: if the turn actually just ended (stale running state),
      # the hook delivers right away; while truly running it no-ops
      "$CMUX_BIN" notify --title "cmux-claude-queue-tick" --body tick --surface "$target" >/dev/null 2>&1
    fi
    [ -n "$CLOSE_TAB" ] && "$CMUX_BIN" close-surface --surface "$CLOSE_TAB" >/dev/null 2>&1
    exit 0
    ;;

  notifyhook)
    # cmux notification hook: echo the policy JSON back unchanged, then use the
    # notification as a delivery tick for every surface with a pending queue.
    # cmux blocks the notification until it has our answer, so the echo must be
    # instant: only our own retry ticks need the python rewrite (they must stay
    # invisible — every boolean effect off); anything else passes straight
    # through on a bash substring check alone.
    payload=$(cat)
    case "$payload" in
      *cmux-claude-queue-tick*)
        out=$(printf '%s' "$payload" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if d.get("notification", {}).get("title") == "cmux-claude-queue-tick":
    eff = d.get("effects") or {}
    for k, v in list(eff.items()):
        if isinstance(v, bool):
            eff[k] = False
    d["effects"] = eff
print(json.dumps(d))' 2>/dev/null) || out=""
        if [ -n "$out" ]; then printf '%s' "$out"; else printf '%s' "$payload"; fi
        ;;
      *) printf '%s' "$payload" ;;
    esac
    exec >>"$QDIR/log.txt" 2>&1  # anything after this must not touch stdout
    shopt -s nullglob
    # Orphan spool sweep. The hotkey daemon spools a draft and clears the box
    # BEFORE handing off, so a handler that never spawned (or died early) left
    # the only copy of that draft on disk — recovery therefore runs BEFORE the
    # housekeeping delete below, or a long-orphaned draft (cmux closed, so no
    # notification ever fired) would be swept away instead of replayed.
    # Anything under 5 s old is a live handoff and is left alone. Nothing
    # usually matches, so the glob is the whole cost on the common path.
    seen=""
    swept=$SECONDS
    for sf in "$QDIR"/*.spool; do
      [ -n "$(/usr/bin/find "$sf" -newermt '-5 seconds' 2>/dev/null)" ] && continue
      sb=$(basename "$sf"); sb=${sb%.*.spool}
      case " $seen " in *" $sb "*) continue ;; esac
      seen="$seen $sb"
      log "notifyhook: recovering orphaned spool for surface=$sb"
      "$0" spool "$sb" >/dev/null 2>&1
      # cmux blocks on this hook: leave the rest for the next notification
      [ $((SECONDS - swept)) -ge 2 ] && break
    done
    # housekeeping: surface ids regenerate on every cmux restart, so drained
    # queues, old markers and stale stamps would otherwise accumulate forever
    # (and slow the glob every statusline refresh pays). The spool patterns are
    # a last-resort backstop only — the sweep above consumes every spool it can
    # parse, so anything reaching this line is unreadable or unroutable.
    /usr/bin/find "$QDIR" \( \( -name '*.queue' -size 0 \) -o -name '*.attempt' \
      -o -name 'capturing-*.stamp' -o -name '*.qlock' -o -name '*.qoffset' \
      -o -name '*.diverge' -o -name '*.resend' -o -name 'sidmap-*' \
      -o -name '*.lock' \
      -o -name '*.sends' -o -name '*.parked' \
      -o -name '*.leftover' -o -name '*.holdoff' \
      -o -name '*.spool' -o -name '*.spool.tmp' \) -mtime +1 -delete 2>/dev/null
    for qf in "$QDIR"/*.queue; do
      [ -s "$qf" ] || continue
      # at most one real keystroke delivery per tick, to stay inside the hook
      # timeout; skipped surfaces get the next notification. Cheap skips
      # (running / locked / user draft) return fast and let the loop continue.
      began=$SECONDS
      deliver_once "$(basename "$qf" .queue)" && break
      [ $((SECONDS - began)) -ge 2 ] && break
    done
    exit 0
    ;;

  add)
    surface="${2:?usage: cmux-claude-queue add <surfaceId> <text>}"
    shift 2
    # queue format is one message per line: an embedded newline would split
    # one prompt into several deliveries
    text=$(printf '%s' "$*" | tr '\n' ' ')
    # deliver_once returns without popping a blank line, so one sitting ahead
    # of real work wedges the surface until housekeeping notices a day later
    case "$text" in *[![:space:]]*) ;; *) log "refused a blank prompt for $surface"; exit 1 ;; esac
    if qlock_take "$surface"; then
      [ -s "$QDIR/$surface.queue" ] \
        || wc -c < "$EVENTS" > "$QDIR/$surface.qoffset" 2>/dev/null
      printf '%s\n' "$text" >> "$QDIR/$surface.queue"
      qlock_drop "$surface"
    else
      printf '%s\n' "$text" >> "$QDIR/$surface.queue"
    fi
    log "add surface=$surface queued: $text"
    [ "$(lifecycle "$surface")" != "running" ] && deliver_once "$surface"
    ;;

  enqueue)
    # append only, no delivery attempt — for callers that must never inject
    # keystrokes themselves (e.g. qq running as a deferred ! command)
    surface="${2:?usage: cmux-claude-queue enqueue <surfaceId> <text>}"
    shift 2
    text=$(printf '%s' "$*" | tr '\n' ' ')
    # deliver_once returns without popping a blank line, so one sitting ahead
    # of real work wedges the surface until housekeeping notices a day later
    case "$text" in *[![:space:]]*) ;; *) log "refused a blank prompt for $surface"; exit 1 ;; esac
    if qlock_take "$surface"; then
      [ -s "$QDIR/$surface.queue" ] \
        || wc -c < "$EVENTS" > "$QDIR/$surface.qoffset" 2>/dev/null
      printf '%s\n' "$text" >> "$QDIR/$surface.queue"
      qlock_drop "$surface"
    else
      printf '%s\n' "$text" >> "$QDIR/$surface.queue"
    fi
    log "enqueue surface=$surface queued: $text"
    ;;

  drain)
    surface="${2:?usage: cmux-claude-queue drain <surfaceId>}"
    end=$((SECONDS + 14400))
    while [ "$SECONDS" -lt "$end" ]; do
      [ -s "$QDIR/$surface.queue" ] || break
      deliver_once "$surface" || sleep 3
    done
    ;;

  manage-open)
    # Open (or refocus) the interactive queue manager for the focused
    # workspace's Claude session, as a bottom split pane. Triggered by the
    # Opt+Shift+Enter hotkey or a Command Palette action.
    ws="${CMUX_WORKSPACE_ID:-}"
    if [ -z "$ws" ]; then
      ws=$("$CMUX_BIN" rpc workspace.current '{}' 2>/dev/null \
        | plutil -extract workspace.id raw -o - -- - 2>/dev/null)
    fi
    [ -z "$ws" ] && { log "manage-open: no workspace"; exit 1; }
    ctx=$(capture_ctx "$ws")
    IFS=$'\x1f' read -r target _ _ _ <<< "$ctx"
    [ -z "$target" ] && target=$(target_surface "$ws")
    if [ -z "$target" ]; then
      "$CMUX_BIN" notify --title "Queue" --body "No Claude session found in this workspace" --workspace "$ws" >/dev/null 2>&1
      exit 0
    fi
    # a manager for this session may already be open: refocus instead of
    # stacking panes (the recorded pane lives in the same workspace, so the
    # focus cannot yank the user's workspace selection)
    pfile="$QDIR/manage-$target.pane"
    old=$(cat "$pfile" 2>/dev/null)
    if [ -n "$old" ] && "$CMUX_BIN" rpc surface.focus "{\"surface_id\": \"$old\"}" >/dev/null 2>&1; then
      exit 0
    fi
    out=$("$CMUX_BIN" new-pane --direction down --workspace "$ws" --focus true --id-format both 2>/dev/null)
    pane=$(printf '%s' "$out" | sed -n 's/.*surface:[0-9]* (\([0-9A-Fa-f-]*\)).*/\1/p')
    [ -z "$pane" ] && { log "manage-open: new-pane failed: $out"; exit 1; }
    printf '%s\n' "$pane" > "$pfile"
    sleep 0.4  # let the pane's shell start before typing into it
    "$CMUX_BIN" send --surface "$pane" "exec '$0' manage $target" >/dev/null 2>&1
    "$CMUX_BIN" send-key --surface "$pane" enter >/dev/null 2>&1
    exit 0
    ;;

  manage)
    # Interactive queue manager; runs inside the pane manage-open creates
    # (exec'd over the shell, so the pane closes itself on exit). Arrows or
    # j/k select, Enter/e edits the line, d deletes, q/Esc closes. Every
    # mutation goes through queue_mutate (qlock + content check), so racing
    # a live delivery is safe. The list auto-refreshes while idle.
    surface="${2:?usage: cmux-claude-queue manage <surfaceId>}"
    trap 'rm -f "$QDIR/manage-$surface.pane"; printf "\033[?25h"' EXIT
    qfile="$QDIR/$surface.queue"
    sel=0
    cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}
    while :; do
      n=0
      items=()
      while IFS= read -r l; do
        [ -n "$l" ] && { items[$n]="$l"; n=$((n + 1)); }
      done < "$qfile" 2>/dev/null
      [ "$sel" -ge "$n" ] && sel=$((n - 1))
      [ "$sel" -lt 0 ] && sel=0
      printf '\033[?25l\033[2J\033[H'
      printf '\033[1m⏳ Prompt queue\033[0m \033[2m(%d waiting)\033[0m\n\n' "$n"
      if [ "$n" -eq 0 ]; then
        printf '  \033[2mempty — new items arrive with Opt+Enter\033[0m\n'
      else
        i=0
        while [ "$i" -lt "$n" ]; do
          item=${items[$i]}
          maxw=$((cols - 8))
          if [ "${#item}" -gt "$maxw" ]; then item="${item:0:$maxw}…"; fi
          if [ "$i" = "$sel" ]; then
            printf '  \033[7m %d. %s \033[0m\n' "$((i + 1))" "$item"
          else
            printf '   %d. %s\n' "$((i + 1))" "$item"
          fi
          i=$((i + 1))
        done
      fi
      printf '\n\033[2m[↑↓/jk] select   [Enter/e] edit   [d] delete   [q/Esc] close\033[0m\n'
      key=""
      t0=$SECONDS
      if ! IFS= read -rsn1 -t 2 key; then
        # slow failure = timeout (refresh the list, a delivery may have run);
        # instant failure = the pane tty is gone, leave
        [ $((SECONDS - t0)) -ge 1 ] && continue
        break
      fi
      case "$key" in
        $'\x1b')
          rest=""
          IFS= read -rsn2 -t 1 rest || true
          case "$rest" in
            '[A') sel=$((sel - 1)) ;;
            '[B') sel=$((sel + 1)) ;;
            '') break ;;  # bare Esc
          esac ;;
        k) sel=$((sel - 1)) ;;
        j) sel=$((sel + 1)) ;;
        q) break ;;
        d)
          [ "$n" -gt 0 ] && queue_mutate "$surface" "$sel" "${items[$sel]}" || true ;;
        e|'')
          if [ "$n" -gt 0 ]; then
            printf '\033[?25h\033[2J\033[H\033[1mEdit item %d\033[0m \033[2m(Enter saves, Ctrl+C cancels)\033[0m\n\n' "$((sel + 1))"
            # bash 3.2 has no read -i; python readline gives a prefilled,
            # editable line. It needs the tty on stdin AND stdout to render
            # the editing, so the result travels via a temp file instead of
            # command substitution.
            edtmp="$QDIR/manage-$surface.edit"
            newtext=""
            if python3 -c '
import readline, sys
readline.set_startup_hook(lambda: readline.insert_text(sys.argv[1]))
try:
    text = input("> ")
except (KeyboardInterrupt, EOFError):
    sys.exit(1)
open(sys.argv[2], "w").write(text)' "${items[$sel]}" "$edtmp" </dev/tty >/dev/tty 2>&1; then
              newtext=$(cat "$edtmp" 2>/dev/null)
            fi
            rm -f "$edtmp"
            newtext=$(printf '%s' "$newtext" | tr '\n' ' ')
            if [ -n "$newtext" ] && [ "$newtext" != "${items[$sel]}" ]; then
              queue_mutate "$surface" "$sel" "${items[$sel]}" "$newtext" || true
            fi
          fi ;;
      esac
      [ "$sel" -lt 0 ] && sel=0
    done
    exit 0
    ;;

  *)
    echo "usage: cmux-claude-queue [capture|statusline|notifyhook|add <surface> <text>|manage-open|drain <surface>]"
    exit 1
    ;;
esac
