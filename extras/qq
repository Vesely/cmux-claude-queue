#!/bin/bash
# qq — queue a follow-up prompt for the current Claude Code session.
#
# Type it inside Claude Code's bash mode; works mid-turn:
#   !qq your next prompt here
#
# Claude Code defers ! commands typed while a turn is running until the turn
# ends. This script then runs as a child of the Claude process (a cmux
# descendant, so the cmux socket accepts it), enqueues the text into the
# cmux-claude-queue prompt queue and fires a "cmux-claude-queue-tick" notification. The
# cmux-claude-queue notification hook suppresses that notification's effects (no
# banner, no sound) and uses it as the trigger to deliver the queued text as a
# fresh prompt once the session is idle.
#
# Caveat: the text is parsed by the shell first. Plain sentences are fine
# (words are re-joined with single spaces), but unbalanced quotes, $, or
# backticks will be interpreted or fail before qq ever sees them.
set -u
surface="${CMUX_SURFACE_ID:-}"
[ -n "$surface" ] || { echo "qq: CMUX_SURFACE_ID not set (not inside cmux)"; exit 1; }
[ $# -gt 0 ] || { echo "usage: !qq <text>"; exit 1; }

CQ="$HOME/.local/bin/cmux-claude-queue"
CMUX_BIN="cmux"
command -v "$CMUX_BIN" >/dev/null 2>&1 || CMUX_BIN="/Applications/cmux.app/Contents/Resources/bin/cmux"

# enqueue only — never inject keystrokes from here: while this deferred
# command runs the TUI buffers them into a queued message that submits a turn
# later, which shows up as a phantom duplicate. The invisible tick makes the
# notification hook deliver right after this process exits.
"$CQ" enqueue "$surface" "$@" >/dev/null 2>&1
"$CMUX_BIN" notify --title "cmux-claude-queue-tick" --body tick --surface "$surface" >/dev/null 2>&1
echo "qq: queued, delivers after the current turn"
